@page "/admin"
@rendermode InteractiveServer
@using AWYKEN.Shared.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AwykenDbContext> ContextFactory
@inject AWYKEN.Shared.Data.IAwykenDataService DataService
@inject NavigationManager Nav

<PageTitle>AWYKEN Admin</PageTitle>
<div class="admin-shell">
 <aside class="admin-sidebar">
  <a class="admin-brand" href="/admin"><img class="brand-logo" src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="AWYKEN logo" /><span>AWYKEN</span></a>
  <div class="sidebar-label">MAIN MENU</div>
  <nav class="admin-nav" aria-label="Admin navigation">
   @foreach (var item in Navigation) { <button class="nav-item @(activeSection == item.Key ? "selected" : "")" @onclick="() => Select(item.Key)"><span class="nav-icon">@item.Icon</span><span>@item.Label</span></button> }
  </nav>
  <div class="sidebar-label system-label">SYSTEM</div>
  <nav class="admin-nav system-nav" aria-label="System navigation">
   <button class="nav-item @(activeSection == "Administrators" ? "selected" : "")" @onclick='() => Select("Administrators")'><span class="nav-icon">♙</span><span>Administrator Management</span></button>
   <button class="nav-item @(activeSection == "Activity Logs" ? "selected" : "")" @onclick='() => Select("Activity Logs")'><span class="nav-icon">▤</span><span>Activity Logs</span></button>
   <button class="nav-item @(activeSection == "Settings" ? "selected" : "")" @onclick='() => Select("Settings")'><span class="nav-icon">⚙</span><span>Settings</span></button>
  </nav>
  <div class="sidebar-account"><span class="account-kicker">ADMIN ACCESS</span><strong>Administrator</strong><span class="account-sub">AWYKEN school portal</span></div>
 </aside>
 <main class="admin-main">
  <header class="admin-topbar"><label class="admin-search"><span>⌕</span><input placeholder="Search students, subjects, events..." @bind="searchText" @bind:event="oninput" /></label><div class="topbar-right"><span class="access-pill">Admin Access</span><button class="notification-button" title="Notifications">♧</button><span class="user-avatar">A</span><div class="greeting"><strong>Good morning, Admin</strong><span>@DateTime.Now.ToString("dddd, MMMM d")</span></div></div></header>
  <section class="admin-content">
   @if (accessDenied) {
    <div class="notice error-notice"><strong>Administrator access required</strong><span>Sign in with an administrator account to open this dashboard.</span><button @onclick='() => Nav.NavigateTo("/settings")'>Go to sign in</button></div>
   } else {
   <div class="page-heading"><div><div class="eyebrow">AWYKEN ADMIN <span>·</span> @DateTime.Now.ToString("dddd, MMMM d").ToUpperInvariant()</div><h1>@activeSection</h1><p>@SectionSubtitle</p></div><button class="outline-action" @onclick="RefreshData">↻ &nbsp; Refresh data</button></div>
   @if (!string.IsNullOrWhiteSpace(loadError)) { <div class="notice error-notice"><strong>Database connection issue</strong><span>@loadError</span><button @onclick="RefreshData">Retry</button></div> }
   else if (loading) { <div class="notice">Connecting to the AWYKEN database…</div> }
   else if (activeSection == "Dashboard") {
    <div class="stats-grid">
     <article class="stat-card"><div class="stat-top"><span>Total students</span><span class="stat-icon">♧</span></div><strong>@registeredStudents</strong><small>Registered student accounts</small></article>
     <article class="stat-card"><div class="stat-top"><span>Active students</span><span class="stat-icon">◉</span></div><strong>@registeredStudents</strong><small>Accounts in the current database</small></article>
     <article class="stat-card"><div class="stat-top"><span>Total subjects</span><span class="stat-icon">▤</span></div><strong>@subjects</strong><small>Distinct subjects in saved schedules</small></article>
     <article class="stat-card"><div class="stat-top"><span>Total classes</span><span class="stat-icon">▦</span></div><strong>@classes</strong><small>Scheduled class records</small></article>
    </div>
    <div class="dashboard-grid">
     <section class="feature-card calendar-card"><div class="card-heading"><div><h2>Academic calendar</h2><p>School events and important dates</p></div><span class="coming-tag">CALENDAR</span></div><div class="empty-state"><span class="empty-icon">▦</span><strong>Calendar events are not connected yet</strong><p>The current database has no school calendar table. Events added here can be published to students once calendar storage is configured.</p></div><button class="primary-action" @onclick='() => Select("School Calendar")'>Manage calendar <span>→</span></button></section>
     <section class="feature-card"><div class="card-heading"><div><h2>Upcoming events</h2><p>Holidays, examinations, and school activities</p></div><span class="muted-link">View all</span></div><div class="empty-state compact"><span class="empty-icon">◷</span><strong>No school events available</strong><p>Connect the school calendar to display upcoming dates.</p></div></section>
     <section class="feature-card activity-card"><div class="card-heading"><div><h2>Recent activity</h2><p>Latest student accounts in the database</p></div><span class="live-dot">LIVE DATA</span></div>
      @if (recentStudents.Count == 0) { <div class="empty-state compact"><strong>No registered students yet</strong><p>New student accounts will appear here.</p></div> } else { <div class="activity-list">@foreach (var student in recentStudents) { <div class="activity-row"><span class="activity-avatar">@Initial(student.DisplayName)</span><div><strong>@(student.DisplayName ?? student.FullName ?? "Student account")</strong><span>Student account in database</span></div><time>#@student.Id</time></div> }</div> }
     </section>
     <section class="feature-card announcement-card"><div class="card-heading"><div><h2>Announcements</h2><p>School wide updates for students</p></div><span class="coming-tag">ANNOUNCEMENTS</span></div><div class="empty-state compact"><span class="empty-icon">▱</span><strong>Announcement storage is not configured</strong><p>No announcement records are stored in the current database.</p></div><button class="text-action" @onclick='() => Select("Announcements")'>Announcement management <span>→</span></button></section>
    </div>
    <section class="quick-actions"><div><h2>Quick actions</h2><p>Manage AWYKEN academic information</p></div><button @onclick='() => Select("School Calendar")'><span>＋</span> Add event</button><button @onclick='() => Select("Announcements")'><span>＋</span> Add announcement</button><button @onclick='() => Select("Academic Management")'><span>▦</span> Manage academics</button></section>
   } else if (activeSection == "Student Management") {
    <section class="feature-card student-panel"><div class="card-heading"><div><h2>Registered students</h2><p>@filteredStudents.Count student accounts found in the database</p></div><span class="live-dot">LIVE DATA</span></div><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>STUDENT NUMBER</th><th>PROGRAM</th><th>YEAR / SECTION</th><th>ACCOUNT ID</th></tr></thead><tbody>
    @foreach (var student in filteredStudents) { <tr><td><div class="student-name"><span class="activity-avatar">@Initial(student.DisplayName ?? student.FullName)</span><span><strong>@(student.DisplayName ?? student.FullName ?? "Unnamed student")</strong><small>@(student.StudentEmail ?? student.Email ?? "No email on file")</small></span></div></td><td>@(student.StudentNumber ?? "—")</td><td>@(student.Program ?? student.College ?? "—")</td><td>@($"{student.YearLevel ?? "—"} · {student.Section ?? "—"}")</td><td>#@student.Id</td></tr> }
    @if (filteredStudents.Count == 0) { <tr><td colspan="5" class="no-results">No students match this search.</td></tr> }
    </tbody></table></div></section><p class="data-note">Account activation, suspension, registration dates, and last activity are not represented in the existing student database schema.</p>
   } else if (activeSection == "Academic Management") { <AcademicManagementPanel />
   } else { <section class="feature-card module-placeholder"><div class="empty-state"><span class="empty-icon">@IconFor(activeSection)</span><strong>@PlaceholderTitle</strong><p>@PlaceholderDescription</p></div><div class="database-status"><span class="status-dot"></span><span>Database status: connected</span><small>Existing student accounts and schedules are available to the dashboard.</small></div></section> }
   }
  </section>
 </main>
</div>

@code {
 private sealed record MenuItem(string Key, string Label, string Icon);
 private static readonly MenuItem[] Navigation = [new("Dashboard", "Dashboard", "⌂"), new("Student Management", "Student Management", "♧"), new("Academic Management", "Academic Management", "▤"), new("School Calendar", "School Calendar", "▦"), new("Announcements", "Announcements", "▱")];
 private string activeSection = "Dashboard", searchText = "";
 private bool loading = true;
 private bool accessDenied;
 private string? loadError;
 private int registeredStudents, classes, subjects;
 private List<UserProfileRecord> students = [], recentStudents = [];
 private List<UserProfileRecord> filteredStudents => students.Where(s => string.IsNullOrWhiteSpace(searchText) || string.Join(" ", s.DisplayName, s.FullName, s.StudentNumber, s.Email, s.StudentEmail, s.Program, s.Section).Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
 private string SectionSubtitle => activeSection switch { "Dashboard" => "A clear view of AWYKEN’s academic activity and student accounts.", "Student Management" => "Search and review student account information from the live database.", "Academic Management" => "School wide subjects, classes, academic periods, and official schedules.", "School Calendar" => "Manage holidays, suspensions, examinations, and academic events.", "Announcements" => "Prepare school wide and academic announcements for students.", "Administrators" => "Manage administrator accounts and access permissions.", "Activity Logs" => "Review administrative actions and system activity.", _ => "Configure AWYKEN application settings." };
 private string PlaceholderTitle => activeSection switch { "Academic Management" => "Official academic management is not stored yet", "School Calendar" => "School calendar is not stored yet", "Announcements" => "Announcements are not stored yet", "Administrators" => "Administrator access", "Activity Logs" => "Activity logs are not configured", _ => "Admin settings are not configured" };
 private string PlaceholderDescription => activeSection switch { "Academic Management" => "The current schedule records are student owned. Add official subject, class, and academic period records to enable school wide management.", "School Calendar" => "Add a calendar events data source to publish holidays, suspensions, semester breaks, and examination dates.", "Announcements" => "Add announcement storage to create and schedule student notifications.", "Administrators" => "Admin access is granted by listing an email in AWYKEN_ADMIN_EMAILS. Editing roles from this screen is not implemented yet.", "Activity Logs" => "The current database does not record administrative activity.", _ => "System settings and backup controls are not available in the current database." };
 protected override async Task OnInitializedAsync()
 {
  try
  {
   await DataService.InitializeAsync();
   // The role check runs on the server: a signed-in student never receives this page's data.
   // Refusing in place instead of redirecting avoids a NavigationException during the first render.
   if (!await DataService.IsAdminAsync())
   {
    accessDenied = true;
    loading = false;
    return;
   }
   await RefreshData();
  }
  catch (Exception exception)
  {
   loadError = exception.GetBaseException().Message;
   loading = false;
  }
 }
 private void Select(string section) => activeSection = section;
 private string IconFor(string section) => section switch { "Academic Management" => "▤", "School Calendar" => "▦", "Announcements" => "▱", "Administrators" => "♙", "Activity Logs" => "▤", _ => "⚙" };
 private static string Initial(string? name) => string.IsNullOrWhiteSpace(name) ? "S" : name.Trim()[0].ToString().ToUpperInvariant();
 private async Task RefreshData() { loading = true; loadError = null; try { await DataService.InitializeAsync(); await using var db = await ContextFactory.CreateDbContextAsync(); students = await db.Profiles.AsNoTracking().Where(p => p.Email != null).OrderBy(p => p.DisplayName).Select(p => new UserProfileRecord { Id = p.Id, DisplayName = p.DisplayName, FullName = p.FullName, StudentNumber = p.StudentNumber, Email = p.Email, StudentEmail = p.StudentEmail, Program = p.Program, College = p.College, YearLevel = p.YearLevel, Section = p.Section }).ToListAsync(); registeredStudents = students.Count; classes = await db.Schedule.AsNoTracking().CountAsync(); subjects = await db.Schedule.AsNoTracking().Select(s => s.CourseCode).Distinct().CountAsync(); recentStudents = students.OrderByDescending(p => p.Id).Take(4).ToList(); } catch (Exception ex) { loadError = ex.GetBaseException().Message; } finally { loading = false; } }
}
