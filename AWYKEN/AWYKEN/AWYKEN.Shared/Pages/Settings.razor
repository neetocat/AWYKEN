@page "/settings"
@using AWYKEN.Shared.Data
@using Microsoft.JSInterop
@inject AWYKEN.Shared.Services.DashboardState State
@inject IAwykenDataService Data
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Settings - AWYKEN</PageTitle>

<div class="flow-shell settings-screen">
    <main class="flow-scroll">
        <div class="flow-content">
            <header class="settings-header app-page-header">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png"
                         alt="AWYKEN logo" />
                </div>

                <div class="settings-title">
                    <h1>Settings</h1>
                    <p>Manage your AWYKEN</p>
                </div>

                <button class="outline-icon-button"
                        aria-label="Notifications"
                        @onclick='() => Navigation.NavigateTo("/notification")'>
                    @Icon("bell")
                </button>
            </header>

            <section class="profile-card account-trigger"
                     tabindex="0"
                     @onclick="OpenAccountCard"
                     @onkeydown="HandleProfileKeyDown">

                <div class="avatar">@ProfileInitials</div>

                <div class="profile-copy">
                    <h2>@(State.Student.FullName ?? State.User.DisplayName)</h2>
                    <p>
                        @(string.IsNullOrWhiteSpace(State.User.Email)
                            ? "No email saved"
                            : State.User.Email)
                    </p>
                </div>

                @if (Data.IsAuthenticated)
                {
                    <button class="row-action logout-action"
                            aria-label="Log out"
                            @onclick="OpenLogoutConfirmation"
                            @onclick:stopPropagation="true">
                        Log out
                    </button>
                }
                else
                {
                    <button class="row-action"
                            aria-label="Log in or sign up"
                            @onclick="OpenAccountCard"
                            @onclick:stopPropagation="true">
                        ♢
                    </button>
                }
            </section>

            <!-- SCHEDULE -->

            <section class="settings-section">
                <h2>SCHEDULE</h2>

                <button class="settings-row"
                        @onclick='() => Navigation.NavigateTo("/schedule")'>
                    <span class="row-icon">@Icon("calendar")</span>

                    <span class="row-copy">
                        <strong>Class schedule</strong>
                        <small>@ClassSummary</small>
                    </span>

                    <span class="row-chevron">@Icon("chevron")</span>
                </button>

                <button class="settings-row"
                        @onclick='() => Navigation.NavigateTo("/import-cor")'>
                    <span class="row-icon">@Icon("scan")</span>

                    <span class="row-copy">
                        <strong>Import another COR</strong>
                        <small>Scan or upload a document</small>
                    </span>

                    <span class="row-chevron">@Icon("chevron")</span>
                </button>
            </section>

            <!-- REMINDERS -->

            <section class="settings-section">
                <h2>REMINDERS</h2>

                <div class="settings-row">
                    <span class="row-icon">@Icon("clock")</span>

                    <span class="row-copy">
                        <strong>Preparation time</strong>
                        <small>15 minutes before leaving</small>
                    </span>

                    <button class="toggle @(preparationEnabled ? "on" : "")"
                            @onclick="() => preparationEnabled = !preparationEnabled"
                            role="switch"
                            aria-checked="@preparationEnabled"
                            aria-label="Toggle preparation time">
                        <span></span>
                    </button>
                </div>

                <div class="settings-row">
                    <span class="row-icon">@Icon("route")</span>

                    <span class="row-copy">
                        <strong>Commute reminders</strong>
                        <small>Based on live travel estimate</small>
                    </span>

                    <button class="toggle @(commuteEnabled ? "on" : "")"
                            @onclick="() => commuteEnabled = !commuteEnabled"
                            role="switch"
                            aria-checked="@commuteEnabled"
                            aria-label="Toggle commute reminders">
                        <span></span>
                    </button>
                </div>

                <div class="settings-row">
                    <span class="row-icon">@Icon("bell")</span>

                    <span class="row-copy">
                        <strong>Class notifications</strong>
                        <small>10 minutes before class</small>
                    </span>

                    <button class="toggle @(notificationsEnabled ? "on" : "")"
                            @onclick="() => notificationsEnabled = !notificationsEnabled"
                            role="switch"
                            aria-checked="@notificationsEnabled"
                            aria-label="Toggle class notifications">
                        <span></span>
                    </button>
                </div>
            </section>

            <!-- PREFERENCES -->

            <section class="settings-section">
                <h2>PREFERENCES</h2>

                <button class="settings-row"
                        @onclick='() => Navigation.NavigateTo("/commute")'>
                    <span class="row-icon">@Icon("pin")</span>

                    <span class="row-copy">
                        <strong>Home location</strong>
                        <small>
                            @(string.IsNullOrWhiteSpace(State.CommuteLocations.HomeAddress)
                                ? "Tap to set home and campus"
                                : State.CommuteLocations.HomeAddress)
                        </small>
                    </span>

                    <span class="row-chevron">@Icon("chevron")</span>
                </button>

                <!-- TIME FORMAT -->

                <button class="settings-row"
                        @onclick="OpenTimeFormat">
                    <span class="row-icon">@Icon("clock")</span>

                    <span class="row-copy">
                        <strong>Time format</strong>

                        <small>
                            @(Use24HourTime
                                ? "24-hour format (13:30)"
                                : "12-hour format (1:30 PM)")
                        </small>
                    </span>

                    <span class="row-chevron">@Icon("chevron")</span>
                </button>

                <!-- ABOUT AWYKEN -->

                <button class="settings-row"
                        @onclick="OpenAbout">
                    <span class="row-icon">@Icon("info")</span>

                    <span class="row-copy">
                        <strong>About AWYKEN</strong>
                        <small>Version 1.0.0 · App information</small>
                    </span>

                    <span class="row-chevron">@Icon("chevron")</span>
                </button>
            </section>

        </div>
    </main>

    <!-- BOTTOM NAVIGATION -->

    <nav class="bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="nav-icon">@Icon("home", 22)</span><span class="nav-label">Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="nav-icon">@Icon("calendar", 22)</span><span class="nav-label">Schedule</span></button>
        <button class="add-nav" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'><span class="add-button">+</span><span class="nav-label">Add</span></button>
        <button @onclick='() => Navigation.NavigateTo("/notification")'><span class="nav-icon alert-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg></span><span class="nav-label">Alerts</span></button>
        <button class="active" aria-current="page"><span class="nav-icon" aria-hidden="true">♙</span><span class="nav-label">Profile</span></button>
    </nav>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="flow-toast" role="status">
            @message
        </div>
    }
</div>

<!-- TIME FORMAT DIALOG -->
@if (ShowTimeFormatDialog)
{
    <div class="account-modal-backdrop"
         @onclick="CloseTimeFormat">

        <section class="account-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="time-format-title"
                 @onclick:stopPropagation="true">

            <button class="account-modal-close"
                    aria-label="Close"
                    @onclick="CloseTimeFormat">
                ×
            </button>

            <h2 id="time-format-title">Time format</h2>

            <p class="account-modal-subtitle">
                Choose how time is displayed in AWYKEN.
            </p>

            <div class="account-mode-toggle">
                <button class="@(Use24HourTime ? "" : "selected")"
                        aria-pressed="@(!Use24HourTime)"
                        @onclick="() => SaveTimeFormat(false)">
                    12-hour
                </button>

                <button class="@(Use24HourTime ? "selected" : "")"
                        aria-pressed="@Use24HourTime"
                        @onclick="() => SaveTimeFormat(true)">
                    24-hour
                </button>
            </div>

            <div style="margin-top: 20px;">
                <p>
                    <strong>12-hour example:</strong> 1:30 PM
                </p>

                <p>
                    <strong>24-hour example:</strong> 13:30
                </p>
            </div>

            <button class="account-submit"
                    style="margin-top: 20px;"
                    @onclick="CloseTimeFormat">
                Done
            </button>

        </section>
    </div>
}

<!-- ABOUT AWYKEN DIALOG -->
@if (ShowAboutDialog)
{
    <div class="account-modal-backdrop"
         @onclick="CloseAbout">

        <section class="account-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="about-awyken-title"
                 @onclick:stopPropagation="true">

            <button class="account-modal-close"
                    aria-label="Close"
                    @onclick="CloseAbout">
                ×
            </button>

            <div style="text-align: center; margin-bottom: 20px;">

                <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png"
                     alt="AWYKEN logo"
                     style="width: 90px; height: 90px; object-fit: contain;" />

                <h2 id="about-awyken-title">About AWYKEN</h2>

                <p class="account-modal-subtitle">
                    Your student schedule companion.
                </p>

            </div>

            <hr />

            <p>
                <strong>Application:</strong> AWYKEN
            </p>

            <p>
                <strong>Version:</strong> 1.0.0
            </p>

            <p>
                <strong>Purpose:</strong>
            </p>

            <p>
                AWYKEN helps students manage their class schedules,
                organize their school day, and plan their commute.
            </p>

            <p>
                Keep your classes organized and make your daily
                school routine easier with AWYKEN.
            </p>

            <button class="account-submit"
                    style="margin-top: 20px;"
                    @onclick="CloseAbout">
                Done
            </button>

        </section>
    </div>
}

<!-- ACCOUNT LOGIN / SIGNUP DIALOG -->
@if (ShowAccountCard && !Data.IsAuthenticated)
{
    <div class="account-modal-backdrop"
         @onclick="CloseAccountCard">

        <section class="account-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="account-card-title"
                 @onclick:stopPropagation="true">

            <button class="account-modal-close"
                    aria-label="Close"
                    @onclick="CloseAccountCard">
                ×
            </button>

            <h2 id="account-card-title">Your AWYKEN account</h2>

            <p class="account-modal-subtitle">
                Sign in to keep your schedule with your local profile.
            </p>

            <div class="account-mode-toggle"
                 role="tablist"
                 aria-label="Account action">

                <button class="@(AccountMode == "Login" ? "selected" : "")"
                        role="tab"
                        aria-selected="@(AccountMode == "Login")"
                        @onclick='() => SetAccountMode("Login")'>
                    Log in
                </button>

                <button class="@(AccountMode == "SignUp" ? "selected" : "")"
                        role="tab"
                        aria-selected="@(AccountMode == "SignUp")"
                        @onclick='() => SetAccountMode("SignUp")'>
                    Sign up
                </button>

            </div>

            @if (AccountMode == "SignUp")
            {
                <label class="account-field">
                    Name <span>(optional)</span>
                    <input @bind="DisplayNameInput"
                           autocomplete="name"
                           maxlength="100" />
                </label>
            }

            <label class="account-field">
                Email
                <input type="email"
                       @bind="EmailInput"
                       autocomplete="email" />
            </label>

            <label class="account-field">
                Password
                <input type="password"
                       @bind="PasswordInput"
                       autocomplete="@(AccountMode == "Login"
                           ? "current-password"
                           : "new-password")" />
            </label>

            @if (AccountMode == "SignUp")
            {
                <label class="account-field">
                    Confirm password
                    <input type="password"
                           @bind="ConfirmPasswordInput"
                           autocomplete="new-password" />
                </label>

                <p class="account-password-hint">
                    Use at least 8 characters.
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(AccountError))
            {
                <p class="account-error" role="alert">
                    @AccountError
                </p>
            }

            <button class="account-submit"
                    disabled="@Working"
                    @onclick="SubmitAccount">

                @(Working
                    ? "Please wait…"
                    : AccountMode == "Login"
                        ? "Log in"
                        : "Create account")

            </button>

            <p class="account-local-note">
                This account and its password hash are stored
                in this app's local database.
            </p>

        </section>
    </div>
}

<!-- LOGOUT CONFIRMATION -->
@if (ShowLogoutPrompt)
{
    <div class="account-modal-backdrop"
         @onclick="CancelLogout">

        <section class="account-confirm-card"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="logout-title"
                 @onclick:stopPropagation="true">

            <h2 id="logout-title">Log out?</h2>

            <p>
                Are you sure you want to log out of
                @State.User.DisplayName?
            </p>

            <div class="account-confirm-actions">

                <button @onclick="CancelLogout">
                    No, stay logged in
                </button>

                <button class="confirm-logout"
                        @onclick="Logout">
                    Yes, log out
                </button>

            </div>

        </section>
    </div>
}

@code {
    private bool preparationEnabled = false;
    private bool commuteEnabled = true;
    private bool notificationsEnabled = true;

    private string? message;

    private bool ShowAccountCard;
    private bool ShowLogoutPrompt;
    private bool ShowTimeFormatDialog;
    private bool ShowAboutDialog;

    private bool Working;

    private bool Use24HourTime;
    private bool TimeFormatLoaded;

    private string AccountMode = "Login";
    private string DisplayNameInput = "";
    private string EmailInput = "";
    private string PasswordInput = "";
    private string ConfirmPasswordInput = "";

    private string? AccountError;

    private string ClassSummary =>
        $"{State.Schedule.Count} " +
        $"{(State.Schedule.Count == 1 ? "class" : "classes")} saved locally";

    // SVG icons

    private static readonly Dictionary<string, string> IconPaths = new()
    {
        ["calendar"] =
            "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/>" +
            "<path d=\"M16 2v4M8 2v4M3 10h18\"/>",

        ["scan"] =
            "<path d=\"M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10\"/>",

        ["clock"] =
            "<circle cx=\"12\" cy=\"12\" r=\"9\"/>" +
            "<path d=\"M12 7v5l3 2\"/>",

        ["route"] =
            "<circle cx=\"6\" cy=\"19\" r=\"2\"/>" +
            "<circle cx=\"18\" cy=\"5\" r=\"2\"/>" +
            "<path d=\"M8 19h6a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h6\"/>",

        ["bell"] =
            "<path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/>" +
            "<path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/>",

        ["pin"] =
            "<path d=\"M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z\"/>" +
            "<circle cx=\"12\" cy=\"10\" r=\"3\"/>",

        ["info"] =
            "<circle cx=\"12\" cy=\"12\" r=\"9\"/>" +
            "<path d=\"M12 16v-4M12 8h.01\"/>",

        ["pencil"] =
            "<path d=\"M12 20h9\"/>" +
            "<path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/>",

        ["chevron"] =
            "<path d=\"m9 18 6-6-6-6\"/>",

        ["home"] =
            "<path d=\"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/>",

        ["plus"] =
            "<path d=\"M12 5v14M5 12h14\"/>",

        ["user"] =
            "<circle cx=\"12\" cy=\"8\" r=\"4\"/>" +
            "<path d=\"M4 21a8 8 0 0 1 16 0\"/>"
    };

    private static MarkupString Icon(string name, int size = 18) => new(
        $"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"{size}\" height=\"{size}\" " +
        "fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" " +
        $"stroke-linejoin=\"round\" aria-hidden=\"true\">{IconPaths[name]}</svg>");

    // Load profile and schedule data.

    protected override Task OnInitializedAsync() =>
        Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));

    // Load the saved time format from browser storage.

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || TimeFormatLoaded)
            return;

        try
        {
            var savedFormat = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "awyken-time-format");

            Use24HourTime = savedFormat == "24";
        }
        catch (JSException)
        {
            Use24HourTime = false;
        }
        catch (InvalidOperationException)
        {
            Use24HourTime = false;
        }

        TimeFormatLoaded = true;

        await InvokeAsync(StateHasChanged);
    }

    // TIME FORMAT

    private void OpenTimeFormat()
    {
        ShowTimeFormatDialog = true;
    }

    private void CloseTimeFormat()
    {
        ShowTimeFormatDialog = false;
    }

    private async Task SaveTimeFormat(bool use24Hour)
    {
        Use24HourTime = use24Hour;

        try
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "awyken-time-format",
                use24Hour ? "24" : "12");

            message = use24Hour
                ? "24-hour time format saved."
                : "12-hour time format saved.";
        }
        catch (JSException)
        {
            message = "Format changed, but the preference could not be saved.";
        }
        catch (InvalidOperationException)
        {
            message = "Format changed for this session.";
        }

        ShowTimeFormatDialog = false;
    }

    // ABOUT AWYKEN

    private void OpenAbout()
    {
        ShowAboutDialog = true;
    }

    private void CloseAbout()
    {
        ShowAboutDialog = false;
    }

    // PROFILE

    private string ProfileInitials =>
        string.IsNullOrWhiteSpace(State.User.FirstName)
            ? "G"
            : string.Concat(
                State.User.FirstName
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Take(2)
                    .Select(part => char.ToUpperInvariant(part[0])));

    private void OpenAccountCard()
    {
        if (Data.IsAuthenticated)
            return;

        ShowAccountCard = true;
        AccountError = null;
    }

    private void CloseAccountCard()
    {
        ShowAccountCard = false;
    }

    private void SetAccountMode(string mode)
    {
        AccountMode = mode;
        AccountError = null;
    }

    private void HandleProfileKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            OpenAccountCard();
    }

    // LOGOUT

    private void OpenLogoutConfirmation()
    {
        ShowLogoutPrompt = true;
    }

    private void CancelLogout()
    {
        ShowLogoutPrompt = false;
    }

    private async Task Logout()
    {
        await Data.SignOutAsync(
            DateOnly.FromDateTime(DateTime.Today));

        ShowLogoutPrompt = false;
        message = "You have been logged out.";
    }

    // LOGIN AND SIGNUP

    private async Task SubmitAccount()
    {
        AccountError = null;

        if (string.IsNullOrWhiteSpace(EmailInput) ||
            string.IsNullOrWhiteSpace(PasswordInput))
        {
            AccountError = "Enter your email and password.";
            return;
        }

        if (AccountMode == "SignUp" &&
            PasswordInput != ConfirmPasswordInput)
        {
            AccountError = "The passwords do not match.";
            return;
        }

        Working = true;

        try
        {
            AccountError = AccountMode == "Login"
                ? await Data.SignInAsync(
                    EmailInput,
                    PasswordInput)
                : await Data.SignUpAsync(
                    DisplayNameInput,
                    EmailInput,
                    PasswordInput);

            if (AccountError is null)
            {
                ShowAccountCard = false;

                DisplayNameInput = "";
                EmailInput = "";
                PasswordInput = "";
                ConfirmPasswordInput = "";

                message = AccountMode == "Login"
                    ? "You are logged in."
                    : "Your account was created.";
            }
        }
        catch
        {
            AccountError =
                "We couldn't complete that account action. Please try again.";
        }
        finally
        {
            Working = false;
        }
    }
}