@page "/settings"
@using AWYKEN.Shared.Data
@inject AWYKEN.Shared.Services.DashboardState State
@inject IAwykenDataService Data
@inject NavigationManager Navigation

<PageTitle>AWYKEN</PageTitle>

<div class="flow-shell settings-screen">
    <main class="flow-scroll">
        <div class="flow-content">
            <header class="settings-header">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="AWYKEN logo" />
                </div>
                <div class="settings-title">
                    <h1>Settings</h1>
                    <p>Manage your AWYKEN</p>
                </div>
                <button class="outline-icon-button" aria-label="Notifications">@Icon("bell")</button>
            </header>

            <section class="profile-card" role="button" tabindex="0" style="cursor: pointer;"
                     aria-label="Open profile"
                     @onclick='() => Navigation.NavigateTo("/profile")'
                     @onkeydown="OpenProfileOnKey">
                <div class="avatar">@ProfileInitials</div>
                <div class="profile-copy">
                    <h2>@(State.Student.FullName ?? State.User.DisplayName)</h2>
                    <p>@(string.IsNullOrWhiteSpace(State.User.Email) ? "No email saved" : State.User.Email)</p>
                </div>
                <span class="row-action" aria-hidden="true">@Icon("pencil")</span>
            </section>

            <section class="settings-section">
                <h2>SCHEDULE</h2>
                <button class="settings-row" @onclick='() => Navigation.NavigateTo("/schedule")'>
                    <span class="row-icon">@Icon("calendar")</span><span class="row-copy"><strong>Class schedule</strong><small>@ClassSummary</small></span><span class="row-chevron">@Icon("chevron")</span>
                </button>
                <button class="settings-row" @onclick='() => Navigation.NavigateTo("/import-cor")'>
                    <span class="row-icon">@Icon("scan")</span><span class="row-copy"><strong>Import another COR</strong><small>Scan or upload a document</small></span><span class="row-chevron">@Icon("chevron")</span>
                </button>
            </section>

            <section class="settings-section">
                <h2>REMINDERS</h2>
                <div class="settings-row"><span class="row-icon">@Icon("clock")</span><span class="row-copy"><strong>Preparation time</strong><small>15 minutes before leaving</small></span><button class="toggle @(preparationEnabled ? "on" : "")" @onclick="() => preparationEnabled = !preparationEnabled" role="switch" aria-checked="@preparationEnabled" aria-label="Toggle preparation time"><span></span></button></div>
                <div class="settings-row"><span class="row-icon">@Icon("route")</span><span class="row-copy"><strong>Commute reminders</strong><small>Based on live travel estimate</small></span><button class="toggle @(commuteEnabled ? "on" : "")" @onclick="() => commuteEnabled = !commuteEnabled" role="switch" aria-checked="@commuteEnabled" aria-label="Toggle commute reminders"><span></span></button></div>
                <div class="settings-row"><span class="row-icon">@Icon("bell")</span><span class="row-copy"><strong>Class notifications</strong><small>10 minutes before class</small></span><button class="toggle @(notificationsEnabled ? "on" : "")" @onclick="() => notificationsEnabled = !notificationsEnabled" role="switch" aria-checked="@notificationsEnabled" aria-label="Toggle class notifications"><span></span></button></div>
            </section>

            <section class="settings-section">
                <h2>PREFERENCES</h2>
                <button class="settings-row" @onclick="ShowLocationMessage"><span class="row-icon">@Icon("pin")</span><span class="row-copy"><strong>Home location</strong><small>Not set</small></span><span class="row-chevron">@Icon("chevron")</span></button>
                <button class="settings-row" @onclick="ShowTimeMessage"><span class="row-icon">@Icon("clock")</span><span class="row-copy"><strong>Time format</strong><small>12-hour</small></span><span class="row-chevron">@Icon("chevron")</span></button>
                <button class="settings-row" @onclick="ShowAboutMessage"><span class="row-icon">@Icon("info")</span><span class="row-copy"><strong>About AWYKEN</strong><small>Version 1.0.0</small></span><span class="row-chevron">@Icon("chevron")</span></button>
            </section>

            <button style="display:block;margin:20px auto 96px;padding:8px 16px;background:none;border:0;color:var(--error);font-size:14px;font-weight:700;cursor:pointer;"
                    @onclick="SignOut">
                Sign out
            </button>
        </div>
    </main>

    <nav class="bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="nav-icon">@Icon("home", 22)</span><span class="nav-label">Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="nav-icon">@Icon("calendar", 22)</span><span class="nav-label">Schedule</span></button>
        <button class="add-nav" aria-label="Add" @onclick='() => Navigation.NavigateTo("/import-cor")'>@Icon("plus", 22)</button>
        <button @onclick='() => Navigation.NavigateTo("/notification")'><span class="nav-icon">@Icon("bell", 22)</span><span class="nav-label">Alerts</span></button>
        <button class="active" aria-current="page"><span class="nav-icon">@Icon("user", 22)</span><span class="nav-label">Settings</span></button>
    </nav>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="flow-toast" role="status">@message</div>
    }
</div>

@code {
    private bool preparationEnabled = false;
    private bool commuteEnabled = true;
    private bool notificationsEnabled = true;
    private string? message;

    // Line icons (24x24 grid, stroke follows the text color so active/inactive states just work).
    private static readonly Dictionary<string, string> IconPaths = new()
    {
        ["calendar"] = "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M16 2v4M8 2v4M3 10h18\"/>",
        ["scan"] = "<path d=\"M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10\"/>",
        ["clock"] = "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/>",
        ["route"] = "<circle cx=\"6\" cy=\"19\" r=\"2\"/><circle cx=\"18\" cy=\"5\" r=\"2\"/><path d=\"M8 19h6a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h6\"/>",
        ["bell"] = "<path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9\"/><path d=\"M10.3 21a1.94 1.94 0 0 0 3.4 0\"/>",
        ["pin"] = "<path d=\"M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/>",
        ["info"] = "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 16v-4M12 8h.01\"/>",
        ["pencil"] = "<path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/>",
        ["chevron"] = "<path d=\"m9 18 6-6-6-6\"/>",
        ["home"] = "<path d=\"M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/>",
        ["plus"] = "<path d=\"M12 5v14M5 12h14\"/>",
        ["user"] = "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>"
    };

    private static MarkupString Icon(string name, int size = 18) => new(
        $"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"{size}\" height=\"{size}\" " +
        "fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" " +
        $"stroke-linejoin=\"round\" aria-hidden=\"true\">{IconPaths[name]}</svg>");

    // The profile and today's class count come from the same SQLite refresh as Home.
    protected override Task OnInitializedAsync() =>
        Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));

    private string ProfileInitials => string.IsNullOrWhiteSpace(State.User.FirstName)
        ? "G"
        : string.Concat(State.User.FirstName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(part => char.ToUpperInvariant(part[0])));

    // "2026-2027 - First Semester" -> "First semester"
    private string? TermLabel
    {
        get
        {
            var term = State.Student.AcademicTerm;
            if (string.IsNullOrWhiteSpace(term))
                return null;
            var label = term[(term.LastIndexOf('-') + 1)..].Trim();
            return label.Length == 0 ? null : label[..1] + label[1..].ToLowerInvariant();
        }
    }

    private string ClassSummary =>
        $"{State.Schedule.Count} {(State.Schedule.Count == 1 ? "class" : "classes")}"
        + (TermLabel is null ? " saved locally" : $" · {TermLabel}");

    private void OpenProfileOnKey(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            Navigation.NavigateTo("/profile");
    }

    private void SignOut() => message = "Sign out isn't available yet. Your data stays on this device.";
    private void ShowLocationMessage() => message = "No home location has been saved yet.";
    private void ShowTimeMessage() => message = "12-hour time format is selected.";
    private void ShowAboutMessage() => message = "AWYKEN · Version 1.0.0";
}