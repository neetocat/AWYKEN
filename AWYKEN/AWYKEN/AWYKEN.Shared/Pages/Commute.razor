@page "/commute"
@using AWYKEN.Shared.Data
@using AWYKEN.Shared.Services
@inject AWYKEN.Shared.Services.DashboardState State
@inject IAwykenDataService Data
@inject ICommuteMapService MapService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>AWYKEN</PageTitle>

<div class="app-shell commute-page">
    <main class="dashboard-scroll">
        <div class="dashboard-content">

            <header class="topbar">
                <button class="icon-button" aria-label="Back" @onclick="GoBack">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                </button>
                <div class="greeting-copy">
                    <p class="greeting">Your commute</p>
                    <p class="muted">@(State.Schedule.Count == 0 ? "No class scheduled" : $"For {State.NextClass.CourseCode} · {State.NextClass.StartTime}")</p>
                </div>
                <div class="weather">
                    <strong>@(State.Weather.Temperature is int temperature ? $"{temperature}°" : "—")</strong>
                </div>
            </header>

            <section class="commute-location-editor" aria-labelledby="commute-location-title">
                <h2 id="commute-location-title">Route locations</h2>
                <label>
                    <span>Home address</span>
                    <input @bind="HomeAddressInput" autocomplete="street-address" maxlength="300"
                           placeholder="Enter your home address" />
                </label>
                <label>
                    <span>School or campus address</span>
                    <input @bind="SchoolAddressInput" autocomplete="street-address" maxlength="300"
                           placeholder="Enter your campus address" />
                </label>
                <button type="button" class="route-search-button" disabled="@IsLoading"
                        @onclick="CalculateRouteAsync">
                    @(IsLoading ? "Finding route…" : "Show route")
                </button>
                <small>When you tap Show route, addresses are sent to OpenStreetMap Nominatim for lookup. Map data © OpenStreetMap contributors.</small>
            </section>

            @if (!string.IsNullOrWhiteSpace(MapError))
            {
                <p class="commute-error" role="alert">@MapError</p>
            }

            <section class="commute-map" aria-label="Map showing your route">
                <div id="commute-map-canvas"></div>
            </section>

            @if (CurrentRoute is not null)
            {
                <section class="commute-summary">
                    <div class="commute-duration">
                        <strong>@TravelMinutes</strong><span>MIN</span>
                    </div>
                    <div class="commute-summary-divider"></div>
                    <div class="commute-leave">
                        <strong>Driving estimate · @DistanceKilometers km</strong>
                        @if (State.Schedule.Count > 0)
                        {
                            <span>Leave by @LeaveByDisplay for @State.NextClass.StartTime</span>
                        }
                        else
                        {
                            <span>Estimated road time from home to campus</span>
                        }
                    </div>
                </section>
            }

            @if (State.Schedule.Count == 0)
            {
                <section class="commute-summary">
                    <div class="commute-leave">
                        <strong>No class scheduled today</strong>
                        <span>Your home-to-campus map is ready above. Add a class to calculate when to leave.</span>
                    </div>
                </section>
            }
            else
            {
            <section class="route-rows">
                <button type="button" class="route-row">
                    <span class="route-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h14V10M10 20v-6h4v6" /></svg>
                    </span>
                    <span class="route-copy">
                        <small>FROM</small>
                        <strong>@(string.IsNullOrWhiteSpace(HomeAddressInput) ? "Home address not set" : HomeAddressInput)</strong>
                    </span>
                    <span class="route-chevron" aria-hidden="true">›</span>
                </button>

                <button type="button" class="route-row">
                    <span class="route-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" /></svg>
                    </span>
                    <span class="route-copy">
                        <small>TO</small>
                        <strong>@(string.IsNullOrWhiteSpace(SchoolAddressInput) ? "Campus address not set" : SchoolAddressInput)</strong>
                    </span>
                    <span class="route-chevron" aria-hidden="true">›</span>
                </button>
            </section>

            <section class="commute-timeline">
                <h2>Your timeline</h2>
                <p class="muted">Stay on track, without rushing</p>

                <ol class="timeline">
                    @foreach (var step in Steps)
                    {
                        <li class="timeline-step">
                            <span class="timeline-dot @step.Kind" aria-hidden="true">
                                @if (step.Kind == "done")
                                {
                                    <svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                                }
                                else if (step.Kind == "active")
                                {
                                    <svg viewBox="0 0 24 24"><path d="M13 4.5a1.5 1.5 0 1 0 0 .01M10 21l2-6-3-3 1-5 4 2 3 1M9 12l-3 1" /></svg>
                                }
                                else if (step.Kind == "travel")
                                {
                                    <svg viewBox="0 0 24 24"><path d="M6 19a2 2 0 1 0 0-.01M18 5a2 2 0 1 0 0-.01M8 18h6a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h6" /></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" /></svg>
                                }
                            </span>
                            <span class="timeline-copy">
                                <strong>@step.Title</strong>
                                <span>@step.Detail</span>
                            </span>
                            <span class="timeline-time">@step.Time</span>
                        </li>
                    }
                </ol>
            </section>

            <section class="reminder-card">
                <span class="reminder-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                </span>
                <span class="reminder-copy">
                    <strong>Leave reminder is @(ReminderOn ? "on" : "off")</strong>
                    <span>@ReminderText</span>
                </span>
                <button type="button"
                        class="switch @(ReminderOn ? "on" : "")"
                        role="switch"
                        aria-checked="@(ReminderOn ? "true" : "false")"
                        aria-label="Leave reminder"
                        @onclick="ToggleReminder">
                    <span></span>
                </button>
            </section>
            }

        </div>
    </main>
</div>

<style>
    .commute-page {
        --commute-tint: color-mix(in srgb, var(--navy) 6%, var(--white));
        --commute-success: #1f8a5b;
        --commute-on-navy: #c2c7d7;
        --commute-navy-line: #303648;
    }

        .commute-page .topbar {
            margin-bottom: 16px;
        }

        .commute-page .weather {
            margin-top: 0;
        }

            .commute-page .weather strong {
                font-size: 22px;
            }

    /* Map */
    .commute-map {
        position: relative;
        height: 280px;
        margin-bottom: 14px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--commute-tint);
    }

    #commute-map-canvas { position: absolute; inset: 0; min-height: 280px; z-index: 1; }

    .commute-location-editor {
        display: grid;
        gap: 10px;
        margin-bottom: 14px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: var(--white);
    }

    .commute-location-editor h2 { margin: 0 0 2px; font-size: 14px; font-weight: 800; }
    .commute-location-editor label { display: grid; gap: 5px; color: var(--muted); font-size: 10px; font-weight: 800; }
    .commute-location-editor input { width: 100%; min-height: 40px; box-sizing: border-box; padding: 9px 11px; border: 1px solid var(--line); border-radius: 9px; background: var(--white); color: var(--ink); font: inherit; font-size: 12px; }
    .commute-location-editor input:focus { outline: 2px solid color-mix(in srgb, var(--navy) 25%, transparent); border-color: var(--navy); }
    .route-search-button { min-height: 42px; border: 0; border-radius: 10px; background: var(--navy); color: var(--white); font-size: 12px; font-weight: 800; cursor: pointer; }
    .route-search-button:disabled { opacity: .65; cursor: wait; }
    .commute-location-editor small { color: var(--muted); font-size: 9px; line-height: 1.5; }
    .commute-error { margin: 0 0 12px; padding: 10px 12px; border-radius: 10px; background: #fff0f0; color: #a33c42; font-size: 11px; }

    .route-line {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

        .route-line path {
            fill: none;
            stroke: var(--navy);
            stroke-width: 2;
            stroke-dasharray: 6 5;
            stroke-linecap: round;
            vector-effect: non-scaling-stroke;
        }

    .map-pin {
        position: absolute;
        display: grid;
        width: 30px;
        height: 30px;
        place-items: center;
        border: 3px solid var(--white);
        border-radius: 50%;
        background: var(--navy);
        color: var(--white);
        transform: translate(-50%, -50%);
        box-shadow: 0 1px 4px rgb(10 20 49 / 20%);
    }

        .map-pin svg {
            width: 14px;
            height: 14px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .map-pin-home {
        left: 18%;
        top: 70%;
    }

    .map-pin-campus {
        left: 82%;
        top: 22%;
    }

    .traffic-tag {
        position: absolute;
        right: 10px;
        bottom: 10px;
        padding: 4px 8px;
        border-radius: 6px;
        background: color-mix(in srgb, var(--commute-success) 12%, var(--white));
        color: var(--commute-success);
        font-size: 8px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    /* Summary card */
    .commute-summary {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        padding: 18px 20px;
        border-radius: 18px;
        background: var(--navy);
        color: var(--white);
        box-shadow: 0 12px 28px rgb(5 10 61 / 12%);
    }

    .commute-duration {
        display: flex;
        align-items: baseline;
        gap: 4px;
    }

        .commute-duration strong {
            font-size: 38px;
            font-weight: 800;
            line-height: 1;
        }

        .commute-duration span {
            color: var(--commute-on-navy);
            font-size: 10px;
            font-weight: 800;
        }

    .commute-summary-divider {
        align-self: stretch;
        width: 1px;
        background: var(--commute-navy-line);
    }

    .commute-leave {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
    }

        .commute-leave strong {
            font-size: 14px;
            font-weight: 800;
        }

        .commute-leave span {
            color: var(--commute-on-navy);
            font-size: 10px;
        }

    /* From / To rows */
    .route-rows {
        margin-bottom: 22px;
    }

    .route-row {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 12px 2px;
        border: 0;
        border-bottom: 1px solid var(--line);
        background: transparent;
        color: var(--ink);
        text-align: left;
    }

    .route-icon {
        display: grid;
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        place-items: center;
        border-radius: 11px;
        background: var(--commute-tint);
        color: var(--navy);
    }

        .route-icon svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .route-copy {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

        .route-copy small {
            color: var(--muted);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .route-copy strong {
            font-size: 12px;
            font-weight: 800;
        }

    .route-chevron {
        color: var(--ink);
        font-size: 24px;
        line-height: 1;
    }

    /* Timeline */
    .commute-timeline h2 {
        margin: 0 0 3px;
        font-size: 16px;
        font-weight: 800;
    }

    .timeline {
        margin: 18px 0 8px;
        padding: 0;
        list-style: none;
    }

    .timeline-step {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding-bottom: 22px;
    }

        .timeline-step:not(:last-child)::before {
            content: "";
            position: absolute;
            top: 38px;
            bottom: 2px;
            left: 17px;
            border-left: 1.5px dashed var(--line);
        }

    .timeline-dot {
        display: grid;
        flex: 0 0 36px;
        width: 36px;
        height: 36px;
        place-items: center;
        border: 1.5px solid var(--line);
        border-radius: 50%;
        background: var(--white);
        color: var(--muted);
    }

        .timeline-dot svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .timeline-dot.done {
            border-color: var(--commute-success);
            background: var(--commute-success);
            color: var(--white);
        }

        .timeline-dot.active {
            border-color: var(--navy);
            background: var(--navy);
            color: var(--white);
        }

    .timeline-copy {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
        padding-top: 2px;
    }

        .timeline-copy strong {
            font-size: 13px;
            font-weight: 800;
        }

        .timeline-copy span {
            color: var(--muted);
            font-size: 10px;
        }

    .timeline-time {
        padding-top: 4px;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* Reminder */
    .reminder-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border-radius: 16px;
        background: var(--commute-tint);
    }

    .reminder-icon {
        display: grid;
        flex: 0 0 34px;
        width: 34px;
        height: 34px;
        place-items: center;
        border-radius: 10px;
        background: var(--white);
        color: var(--navy);
    }

        .reminder-icon svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .reminder-copy {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

        .reminder-copy strong {
            font-size: 12px;
            font-weight: 800;
        }

        .reminder-copy span {
            color: var(--muted);
            font-size: 10px;
        }

    .switch {
        position: relative;
        flex: 0 0 46px;
        width: 46px;
        height: 26px;
        padding: 0;
        border: 0;
        border-radius: 13px;
        background: var(--line);
        transition: background 0.2s;
    }

        .switch span {
            position: absolute;
            top: 3px;
            left: 3px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--white);
            transition: transform 0.2s;
        }

        .switch.on {
            background: var(--navy);
        }

            .switch.on span {
                transform: translateX(20px);
            }
</style>

@code {
    private const int BufferMinutes = 5;
    private const int PreparationMinutes = 15;
    private const string MapElementId = "commute-map-canvas";

    private string HomeAddressInput = "";
    private string SchoolAddressInput = "";
    private bool IsLoading;
    private bool MapBootFailed;
    private string? MapError;
    private DrivingRoute? CurrentRoute;
    private bool ReminderOn = true;

    private int TravelMinutes => CurrentRoute is null
        ? 0
        : Math.Max(1, (int)Math.Ceiling(CurrentRoute.DurationSeconds / 60));
    private string DistanceKilometers => CurrentRoute is null
        ? "0.0"
        : (CurrentRoute.DistanceMeters / 1000).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    private DateTime? ClassStart => DateTime.TryParse(State.NextClass.StartTime, out var value) ? value : null;
    private DateTime? LeaveTime => CurrentRoute is null || ClassStart is null
        ? null
        : ClassStart.Value.AddMinutes(-TravelMinutes - BufferMinutes);
    private string LeaveByDisplay => LeaveTime?.ToString("h:mm tt") ?? "Set a class time to calculate departure";

    // Load stored endpoint addresses and classes before rendering the map.
    protected override async Task OnInitializedAsync()
    {
        await Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));
        HomeAddressInput = State.CommuteLocations.HomeAddress ?? "";
        SchoolAddressInput = State.CommuteLocations.SchoolAddress ?? "";
    }

    // Leaflet is loaded by the shared JS helper; subsequent renders update its markers and route.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (MapBootFailed)
            return;

        try
        {
            var home = State.CommuteLocations;
            var routeCoordinates = CurrentRoute?.Coordinates
                .Select(point => new[] { point.Latitude, point.Longitude }).ToArray() ?? [];
            await JS.InvokeVoidAsync("awykenCommuteMap.render", MapElementId,
                home.HomeLatitude, home.HomeLongitude, home.SchoolLatitude, home.SchoolLongitude,
                routeCoordinates);
        }
        catch (JSException)
        {
            MapBootFailed = true;
            MapError = "The map could not load. Check your internet connection and reopen this page.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CalculateRouteAsync()
    {
        MapError = null;
        if (string.IsNullOrWhiteSpace(HomeAddressInput) || string.IsNullOrWhiteSpace(SchoolAddressInput))
        {
            MapError = "Enter both a home address and a school or campus address.";
            return;
        }

        IsLoading = true;
        try
        {
            var saved = State.CommuteLocations;
            var home = await GetCoordinatesAsync(HomeAddressInput, saved.HomeAddress,
                saved.HomeLatitude, saved.HomeLongitude);
            if (home is null)
            {
                MapError = "We couldn't find that home address. Add a city or postal code and try again.";
                return;
            }

            var school = await GetCoordinatesAsync(SchoolAddressInput, saved.SchoolAddress,
                saved.SchoolLatitude, saved.SchoolLongitude);
            if (school is null)
            {
                MapError = "We couldn't find that school address. Add a city or postal code and try again.";
                return;
            }

            var newLocations = new CommuteLocationSettings(
                HomeAddressInput.Trim(), home.Latitude, home.Longitude,
                SchoolAddressInput.Trim(), school.Latitude, school.Longitude);

            // Save the addresses and coordinates so future visits do not geocode them again.
            await Data.SaveCommuteLocationsAsync(newLocations, DateOnly.FromDateTime(DateTime.Today));
            CurrentRoute = await MapService.GetDrivingRouteAsync(home, school);
        }
        catch (HttpRequestException)
        {
            MapError = "The map service couldn't be reached. Check your internet connection and try again.";
        }
        catch (System.Text.Json.JsonException)
        {
            MapError = "The map service returned an unreadable response. Please try again later.";
        }
        catch (TaskCanceledException)
        {
            MapError = "The map service took too long to respond. Please try again.";
        }
        catch (InvalidOperationException exception)
        {
            MapError = exception.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task<MapCoordinate?> GetCoordinatesAsync(
        string address, string? savedAddress, double? savedLatitude, double? savedLongitude)
    {
        if (address.Trim().Equals(savedAddress?.Trim(), StringComparison.OrdinalIgnoreCase)
            && savedLatitude is double latitude && savedLongitude is double longitude)
            return new MapCoordinate(latitude, longitude);

        // Nominatim is called only after the user taps Show route; there is no autocomplete.
        return await MapService.GeocodeAddressAsync(address);
    }

    private sealed record Step(string Title, string Detail, string Time, string Kind);

    private IEnumerable<Step> Steps
    {
        get
        {
            if (ClassStart is not DateTime classStart || LeaveTime is not DateTime leaveTime)
                return [new Step("Class", State.NextClass.Title, State.NextClass.StartTime, "class")];

            return
            [
                new Step("Prepare", "Notes, calculator, school ID",
                    leaveTime.AddMinutes(-PreparationMinutes).ToString("h:mm tt"), "done"),
                new Step("Leave home", "Using your saved home address",
                    leaveTime.ToString("h:mm tt"), "active"),
                new Step("Drive to campus", $"OSRM estimate · {DistanceKilometers} km",
                    leaveTime.AddMinutes(TravelMinutes).ToString("h:mm tt"), "travel"),
                new Step("Class", State.NextClass.Location,
                    classStart.ToString("h:mm tt"), "class")
            ];
        }
    }

    private string ReminderText => ReminderOn
        ? LeaveTime is DateTime leave ? $"We'll alert you at {leave.AddMinutes(-5):h:mm tt}" : "Add a class and calculate a route to set a reminder time"
        : "Turn on to get alerted before you leave";

    private void ToggleReminder() => ReminderOn = !ReminderOn;

    private void GoBack() => Navigation.NavigateTo("/");
}
