@page "/"
@inject AWYKEN.Shared.Services.DashboardState State
@inject AWYKEN.Shared.Data.IAwykenDataService Data
@inject NavigationManager Navigation

@* AWYKEN dashboard page.
   The shared state is refreshed from the local SQLite database when this page opens. *@

<PageTitle>AWYKEN</PageTitle>


<div class="app-shell">
    <main class="dashboard-scroll">
        <div class="dashboard-content">
            <header class="topbar">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="AWYKEN logo" />
                </div>
                <div class="greeting-copy">
                    <p class="greeting">Good morning, @State.User.DisplayName</p>
                    <p class="muted">@DateTime.Now.ToString("dddd, MMMM d")</p>
                </div>

                <button class="icon-button" aria-label="Notifications" @onclick="OpenNotifications">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                </button>
            </header>

            <section class="day-row">
                <div class="day-copy">
                    <p class="eyebrow">YOUR DAY</p>
                    <h1>You're all set for a focused day.</h1>
                </div>
                <div class="weather">
                    @* BACKEND TODO: replace Weather values with the result from your weather API/service. *@
                    @if (State.Weather.Temperature is int temperature)
                    {
                        <strong>@temperature°</strong>
                    }
                    else
                    {
                        <strong>—</strong>
                    }
                    <span>@State.Weather.Condition</span>
                </div>
            </section>

            @if (State.Schedule.Count == 0)
            {
                <section class="hero-card">
                    <p class="course-code">YOUR SCHEDULE</p>
                    <h2>No classes today</h2>
                    <p>Check another day in Schedule, or add a class to today.</p>
                    <button class="commute-button" @onclick='() => Navigation.NavigateTo("/add-class")'>Add a class</button>
                </section>
            }
            else
            {
            <section class="hero-card">
                <div class="hero-top-row">
                    <span class="next-badge">NEXT CLASS</span>
                    @* BACKEND TODO: calculate StartsIn from the next class's actual start DateTime. *@
                    <span class="hero-muted">Starts in @State.NextClass.StartsIn</span>
                </div>

                @* BACKEND TODO: populate NextClass from the signed-in user's timetable. *@
                <p class="course-code">@State.NextClass.CourseCode</p>
                <h2>@State.NextClass.Title</h2>

                <div class="class-details">
                    <p><span aria-hidden="true">◷</span> <span>@State.NextClass.StartTime</span></p>
                    <p><span aria-hidden="true">⌖</span> <span>@State.NextClass.Location</span></p>
                </div>

                <div class="hero-divider"></div>

                <div class="preparation-row">
                    <div class="preparation-column">
                        <span class="preparation-label">PREPARE BY</span>
                        <strong>@State.NextClass.PrepareBy <small>AM</small></strong>
                    </div>
                    <div class="preparation-divider"></div>
                    <div class="preparation-column">
                        <span class="preparation-label">LEAVE BY</span>
                        <strong>@State.NextClass.LeaveBy <small>AM</small></strong>
                    </div>
                </div>

                @* TODO: replace this placeholder handler with navigation to a commute details page.
                   Example: use NavigationManager.NavigateTo("/commute") once that page exists. *@
                <button class="commute-button"
                        @onclick='() => Navigation.NavigateTo("/commute")'>
                    <span aria-hidden="true">♧</span> &nbsp; View commute plan
                </button>
            </section>
            }

            <section class="schedule-section">
                <div class="schedule-heading">
                    <div>
                        <h2>Today's schedule</h2>
                        @* BACKEND TODO: this count will automatically reflect the schedule list returned by the backend. *@
                    <p class="muted">@State.Schedule.Count @(State.Schedule.Count == 1 ? "class" : "classes")</p>
                    </div>

                    @* TODO: replace this handler with a link/navigation to the full schedule page, e.g. /schedule. *@
                    <button class="text-button"
                            @onclick="OpenSchedule">
                        See all
                    </button>
                </div>

                <div class="schedule-list">
                    @if (State.Schedule.Count == 0)
                    {
                        <p class="muted">No classes scheduled for today.</p>
                    }
                    @foreach (var item in State.Schedule)
                    {
                        <article class="schedule-card" @key="item.Id">
                            <div class="time-column">
                                <strong>@item.Time</strong>
                                <span>@item.Period</span>
                            </div>
                            <div class="color-bar" style="@($"background-color: {item.ColorCode}")"></div>
                            <div class="class-info">
                                <h3>@item.Title</h3>
                                <p>@item.Subtitle</p>
                            </div>

                            @if (item.Type == "online")
                            {
                                @* TODO: wire this button to the actual meeting URL from the backend.
                                   For external URLs, use NavigationManager or a MAUI-aware launcher as appropriate. *@
                                <button class="join-button" @onclick="JoinMeeting">Join</button>
                            }
                            else
                            {
                                @* TODO: navigate to a class details page, e.g. /schedule/@item.Id. *@
                                <button class="arrow-button" aria-label="@($"View {item.Title}")"
                                        @onclick='() => ShowMessage(item.Title, item.Subtitle)'>›</button>
                            }
                        </article>
                    }
                </div>
            </section>
        </div>
    </main>

    <nav class="bottom-nav" aria-label="Main navigation">
        @* Home and Schedule are routed pages; the other tabs remain placeholders. *@
        <button class='@NavClass("Home")' @onclick='() => SelectTab("Home")'>
            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span class="nav-label">Home</span>
        </button>
        <button class='@NavClass("Schedule")' @onclick="OpenSchedule">
            <span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span><span class="nav-label">Schedule</span>
        </button>
        <button class="add-nav-item" @onclick='() => Navigation.NavigateTo("/add-class")'>
            <span class="add-button">+</span><span class="nav-label">Add</span>
        </button>
        <button class='@NavClass("Alerts")' @onclick="OpenNotifications">
            <span class="nav-icon alert-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg></span><span class="nav-label">Alerts</span>
        </button>
        <button class='@NavClass("Profile")' @onclick='() => Navigation.NavigateTo("/settings")'>
            <span class="nav-icon" aria-hidden="true">♙</span><span class="nav-label">Profile</span>
        </button>
    </nav>
</div>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="toast-backdrop" @onclick="DismissMessage">
        <section class="message-dialog" role="dialog" aria-modal="true" aria-label="@MessageTitle"
                 @onclick:stopPropagation="true">
            <h2>@MessageTitle</h2>
            <p>@Message</p>
            <button class="dialog-button" @onclick="DismissMessage">Got it</button>
        </section>
    </div>
}

@code {
    private string ActiveTab { get; set; } = "Home";
    private string? MessageTitle { get; set; }
    private string? Message { get; set; }

    // Load today's rows from SQLite into the shared state used across pages.
    protected override Task OnInitializedAsync() =>
        Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));

    private string NavClass(string tab) =>
        ActiveTab == tab ? "nav-item nav-active" : "nav-item";

    private void SelectTab(string tab)
    {
        ActiveTab = tab;

        // TODO: Replace these temporary dialogs with real route navigation once each page is implemented.
        if (tab == "Home")
            ShowMessage("Home", "You are on Home.");
        else if (tab == "Schedule")
            OpenSchedule();
        else if (tab == "Alerts")
            OpenNotifications();
        else if (tab == "Profile")
            Navigation.NavigateTo("/settings");
    }

    private void OpenSchedule() => Navigation.NavigateTo("/schedule");
    private void OpenNotifications() => Navigation.NavigateTo("/notification");

    private void ShowMessage(string title, string message)
    {
        MessageTitle = title;
        Message = message;
    }

    private void DismissMessage()
    {
        MessageTitle = null;
        Message = null;
    }

    // TODO: connect to ScheduleItem.Link when the real meeting URLs are available.
    // This placeholder deliberately avoids calling a MAUI-only API from AWYKEN.Shared.
    private void JoinMeeting()
    {
        ShowMessage("Google Meet", "Connect this button to the meeting URL when the backend is ready.");
    }

}
