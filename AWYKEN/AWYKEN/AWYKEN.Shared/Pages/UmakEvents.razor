@page "/umak-events"
@using AWYKEN.Shared.Models
@using AWYKEN.Shared.Services
@implements IDisposable
@inject IUmakCalendarService CalendarService
@inject NavigationManager Navigation

<PageTitle>UMak Events - AWYKEN</PageTitle>

<div class="umak-app-shell">
    <main class="umak-scroll">
        <div class="umak-page">
            <header class="umak-header app-page-header">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="" />
                </div>
                <div><h1>UMak Events</h1><p>Semesters, holidays, exams and more</p></div>
            </header>

            <div class="umak-toolbar">
                <label for="umak-school-year">School year</label>
                <select id="umak-school-year" disabled="@IsLoading" @onchange="OnYearChanged">
                    @foreach (var year in Years)
                    {
                        <option value="@year" selected="@(year == SelectedYear)">@YearLabel(year)</option>
                    }
                </select>
            </div>

            @if (IsLoading)
            {
                <section class="umak-state" role="status"><p>Loading events…</p></section>
            }
            else if (ErrorMessage is not null)
            {
                <section class="umak-state error" role="alert">
                    <h2>Couldn't load events</h2>
                    <p>@ErrorMessage</p>
                    <button type="button" @onclick="RetryAsync">Try again</button>
                </section>
            }
            else
            {
                @if (StatusNote is not null)
                {
                    <p class="umak-note" role="status">@StatusNote</p>
                }

                @if (Events.Count == 0)
                {
                    <section class="umak-state">
                        <h2>No events for @YearLabel(SelectedYear)</h2>
                        <p>Try another school year.</p>
                    </section>
                }

                @foreach (var month in Events.GroupBy(MonthOf).OrderBy(group => group.Key))
                {
                    <section class="umak-month" aria-label="@month.Key.ToString("MMMM yyyy")">
                        <h2>@month.Key.ToString("MMMM yyyy")</h2>
                        @foreach (var item in month.OrderBy(e => e.Start))
                        {
                            <article class="@CardClass(item)">
                                <div class="umak-date">
                                    <strong>@item.Start.Day</strong>
                                    <span>@item.Start.ToString("ddd")</span>
                                </div>
                                <div class="umak-body">
                                    <h3>@item.Title</h3>
                                    <div class="umak-meta">
                                        <span class="@ChipClass(item.Type)">@TypeLabel(item.Type)</span>
                                        <span>@WhenText(item)</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p class="umak-desc">@item.Description</p>
                                    }
                                </div>
                            </article>
                        }
                    </section>
                }
            }
        </div>
    </main>

    <nav class="schedule-bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="bottom-icon home-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span>Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="bottom-icon calendar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span><span>Schedule</span></button>
        <button class="add-nav-item" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'><span class="add-button">+</span><span class="nav-label">Add</span></button>
        <button @onclick='() => Navigation.NavigateTo("/notes")'><span class="bottom-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg></span><span>Notes</span></button>
        <button @onclick='() => Navigation.NavigateTo("/settings")'><span class="bottom-icon profile-icon" aria-hidden="true">♙</span><span>Profile</span></button>
    </nav>
</div>

@code {
    private int SelectedYear;
    private IReadOnlyList<int> Years = [];
    private IReadOnlyList<UmakEvent> Events = [];
    private UmakCalendarStatus? Status;
    private bool IsLoading = true;
    private string? ErrorMessage;
    private CancellationTokenSource? _cts;
    private int _requestId;

    protected override async Task OnInitializedAsync()
    {
        // The default is the school year that today (in Manila) falls in.
        SelectedYear = IUmakCalendarService.GetSchoolYear(UmakCalendarParser.TodayInManila());
        await LoadAsync(loadYears: true);
    }

    private async Task OnYearChanged(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var year) || year == SelectedYear)
            return;

        SelectedYear = year;
        await LoadAsync();
    }

    private async Task RetryAsync()
    {
        CalendarService.Refresh(); // re-check the live feed instead of reusing the last result
        await LoadAsync(loadYears: true);
    }

    private async Task LoadAsync(bool loadYears = false)
    {
        // Only the newest request may update the page (the person can change the year quickly).
        _cts?.Cancel();
        _cts?.Dispose();
        var cts = _cts = new CancellationTokenSource();
        var request = ++_requestId;

        IsLoading = true;
        ErrorMessage = null;
        try
        {
            if (loadYears)
                Years = await CalendarService.GetSchoolYearsAsync(cts.Token);

            var events = await CalendarService.GetEventsAsync(SelectedYear, cts.Token);
            if (request != _requestId)
                return;

            Events = events;
            Status = CalendarService.Status;
        }
        catch (OperationCanceledException)
        {
            return; // superseded by a newer request, or the page was closed
        }
        catch (Exception)
        {
            if (request == _requestId)
            {
                Events = [];
                ErrorMessage = "Check your connection and try again.";
            }
        }
        finally
        {
            if (request == _requestId)
                IsLoading = false;
        }
    }

    private string? StatusNote => Status switch
    {
        { Source: UmakCalendarSource.Cache, RetrievedAt: { } saved } =>
            $"You're offline or the calendar is unavailable. Showing the copy saved on {saved.ToLocalTime():MMM d, yyyy h:mm tt}.",
        { Source: UmakCalendarSource.Bundled } =>
            "Showing the official UMak University Calendar AY 2026-2027 (BOR Resolution No. 2026-010). Dates may change, so check umak.edu.ph for updates.",
        _ => null
    };

    // An event that began before the school year (for example, an enrollment period in July) is listed under the first month.
    private DateTime MonthOf(UmakEvent item)
    {
        var yearStart = IUmakCalendarService.GetSchoolYearRange(SelectedYear).Start.ToDateTime(TimeOnly.MinValue);
        var day = item.Start < yearStart ? yearStart : item.Start;
        return new DateTime(day.Year, day.Month, 1);
    }

    private static string YearLabel(int year) => IUmakCalendarService.FormatSchoolYear(year);

    private static bool IsSemester(UmakEventType type) => type is UmakEventType.SemesterStart or UmakEventType.SemesterEnd;

    private static string CardClass(UmakEvent item) => IsSemester(item.Type) ? "umak-card semester" : "umak-card";

    private static string ChipClass(UmakEventType type) => type switch
    {
        UmakEventType.Holiday => "umak-chip holiday",
        UmakEventType.Exam => "umak-chip exam",
        UmakEventType.SemesterStart or UmakEventType.SemesterEnd => "umak-chip semester",
        _ => "umak-chip"
    };

    private static string TypeLabel(UmakEventType type) => type switch
    {
        UmakEventType.SemesterStart => "Semester start",
        UmakEventType.SemesterEnd => "Semester end",
        UmakEventType.Holiday => "Holiday / no classes",
        UmakEventType.Exam => "Exam",
        _ => "Event"
    };

    private static string WhenText(UmakEvent item)
    {
        if (item.IsAllDay)
            return item.End.Date > item.Start.Date ? $"{item.Start:MMM d} – {item.End:MMM d}" : "All day";

        if (item.End.Date > item.Start.Date)
            return $"{item.Start:MMM d, h:mm tt} – {item.End:MMM d, h:mm tt}";

        return item.End > item.Start ? $"{item.Start:h:mm tt} – {item.End:h:mm tt}" : $"{item.Start:h:mm tt}";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
