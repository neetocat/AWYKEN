@page "/notes"
@using AWYKEN.Shared.Data
@inject IAwykenDataService Data
@inject NavigationManager Navigation

<PageTitle>Notes - AWYKEN</PageTitle>

<div class="notes-app-shell">
    <main class="notes-scroll">
        <div class="notes-page">
            <header class="notes-header app-page-header">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="" />
                </div>
                <div><h1>Notes</h1><p>Notes by course and class date</p></div>
            </header>

            @if (CourseNotes.Count == 0)
            {
                <section class="notes-empty">
                    <h2>Your course notes will appear here</h2>
                    <p>Open a class in Schedule, choose Notes, and save a note for that date.</p>
                    <button type="button" @onclick='() => Navigation.NavigateTo("/schedule")'>Open Schedule</button>
                </section>
            }
            else
            {
                @foreach (var group in CourseNotes.GroupBy(note => new { note.CourseCode, note.CourseTitle }))
                {
                    <section class="notes-course-group" aria-label="@($"{group.Key.CourseCode} notes")">
                        <h2>@group.Key.CourseCode <span>@group.Key.CourseTitle</span></h2>
                        @foreach (var note in group.OrderByDescending(item => item.ClassDate))
                        {
                            <article class="course-note-card" @key="note.Id">
                                <div class="course-note-meta">
                                    <time>@note.ClassDate.ToString("ddd, MMM d, yyyy")</time>
                                    <span>@note.CreatedAtText</span>
                                    @if (!string.IsNullOrWhiteSpace(note.AttendanceStatus))
                                    {
                                        <span class="course-note-attendance">@note.AttendanceStatus</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(note.Text))
                                {
                                    <p class="course-note-text">@note.Text</p>
                                }
                                @if (note.ImageData is not null && !string.IsNullOrWhiteSpace(note.ImageContentType))
                                {
                                    <img class="course-note-image"
                                         src="@($"data:{note.ImageContentType};base64,{Convert.ToBase64String(note.ImageData)}")"
                                         alt="Image attached to course note" />
                                }
                            </article>
                        }
                    </section>
                }
            }
        </div>
    </main>

    <nav class="schedule-bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="bottom-icon home-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span>Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="bottom-icon calendar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span><span>Schedule</span></button>
        <button class="add-nav-item" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'><span class="add-button">+</span><span class="nav-label">Add</span></button>
        <button class="current" aria-current="page"><span class="bottom-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg></span><span>Notes</span></button>
        <button @onclick='() => Navigation.NavigateTo("/settings")'><span class="bottom-icon profile-icon" aria-hidden="true">♙</span><span>Profile</span></button>
    </nav>
</div>

@code {
    private IReadOnlyList<CourseNoteRecord> CourseNotes = [];

    protected override async Task OnInitializedAsync() => CourseNotes = await Data.GetCourseNotesAsync();
}
