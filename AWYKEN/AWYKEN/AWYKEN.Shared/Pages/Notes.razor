@page "/notes"
@using AWYKEN.Shared.Data
@using AWYKEN.Shared.Services
@inject IAwykenDataService Data
@inject NavigationManager Navigation

<PageTitle>Notes - AWYKEN</PageTitle>

<div class="notes-app-shell">
    <main class="notes-scroll">
        <div class="notes-page">
            <header class="notes-header app-page-header">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="" />
                </div>
                <div><h1>Notes</h1><p>Your saved notes by subject</p></div>
            </header>

            @if (SelectedCourseCode is null)
            {
                <section class="notes-subjects" aria-label="Subjects with saved notes">
                    @if (CourseNotes.Count == 0)
                    {
                        <section class="notes-empty">
                            <h2>No saved notes yet</h2>
                            <p>Subjects will appear here after you save notes from a class in the Schedule week view.</p>
                            <button type="button" @onclick='() => Navigation.NavigateTo("/schedule")'>Open Schedule</button>
                        </section>
                    }
                    else
                    {
                        <div class="notes-subject-list">
                            @foreach (var group in CourseNotes.GroupBy(note => new { note.CourseCode, note.CourseTitle }))
                            {
                                var latest = group.OrderByDescending(note => note.ClassDate).First();
                                <button type="button" class="event-card notes-subject-card"
                                        style="--event-accent:@GetSubjectColor(group.Key.CourseCode)"
                                        @onclick="() => SelectCourse(group.Key.CourseCode, group.Key.CourseTitle)">
                                    <span class="event-main">
                                        <span class="event-course-code">@group.Key.CourseCode</span>
                                        <span class="notes-subject-title">@group.Key.CourseTitle</span>
                                        <span class="event-details">
                                            <span>@group.Count() @(group.Count() == 1 ? "saved note" : "saved notes")</span>
                                            <span>Latest: @latest.ClassDate.ToString("MMM d, yyyy")</span>
                                        </span>
                                    </span>
                                    <span class="notes-subject-chevron" aria-hidden="true">›</span>
                                </button>
                            }
                        </div>
                    }
                </section>
            }
            else
            {
                <section class="notes-course-group" aria-label="@($"{SelectedCourseCode} notes")">
                    <button type="button" class="notes-back-link" @onclick="ClearSelectedCourse">‹ All subjects</button>
                    <h2>@SelectedCourseCode <span>@SelectedCourseTitle</span></h2>
                    @foreach (var note in SelectedCourseNotes)
                    {
                        <article class="course-note-card" @key="note.Id">
                            <div class="course-note-meta">
                                <time>@note.ClassDate.ToString("ddd, MMM d, yyyy")</time>
                                <span>Schedule: @note.ClassTimeText</span>
                                @if (!string.IsNullOrWhiteSpace(note.AttendanceStatus))
                                {
                                    <span class="course-note-attendance">@note.AttendanceStatus</span>
                                }
                            </div>
                            @if (EditingNoteId == note.Id)
                            {
                                <div class="course-note-editor">
                                    <label>Notes</label>
                                    <textarea @bind="EditText" rows="5"></textarea>
                                    <label>News</label>
                                    <textarea @bind="EditNews" rows="3" placeholder="News for this class date"></textarea>
                                    <fieldset>
                                        <legend>Attendance</legend>
                                        @foreach (var status in AttendanceStatuses)
                        {
                                            <label class="note-attendance-choice">
                                                <input type="radio" name="noteAttendance" value="@status"
                                                       checked="@(EditAttendance == status)"
                                                       @onchange="() => EditAttendance = status" /> @status
                                            </label>
                        }
                                    </fieldset>
                                    <label>Image</label>
                                    <Microsoft.AspNetCore.Components.Forms.InputFile accept="image/*" OnChange="LoadEditImageAsync" />
                                    @if (EditImageData is not null && EditImageContentType is not null)
                                    {
                                        <img class="course-note-image" src="@EditImagePreview" alt="Attached note" />
                                        <button type="button" class="note-edit-link" @onclick="RemoveEditImage">Remove image</button>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(EditError)) { <p class="note-edit-error">@EditError</p> }
                                    <div class="course-note-edit-actions">
                                        <button type="button" @onclick="() => SaveEditAsync(note.Id)">Save changes</button>
                                        <button type="button" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (!string.IsNullOrWhiteSpace(note.Text))
                                {
                                    <p class="course-note-text">@note.Text</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(note.News))
                                {
                                    <section class="course-note-news"><h3>News</h3><p>@note.News</p></section>
                                }
                                @if (note.ImageData is not null && !string.IsNullOrWhiteSpace(note.ImageContentType))
                                {
                                    <img class="course-note-image"
                                         src="@($"data:{note.ImageContentType};base64,{Convert.ToBase64String(note.ImageData)}")"
                                         alt="Image attached to course note" />
                                }
                                <button type="button" class="note-edit-link" @onclick="() => OpenEdit(note)">Edit this day</button>
                            }
                        </article>
                    }
                </section>
            }
        </div>
    </main>

    <nav class="schedule-bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="bottom-icon home-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span>Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="bottom-icon calendar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span><span>Schedule</span></button>
        <button class="add-nav-item" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'><span class="add-button">+</span><span class="nav-label">Add</span></button>
        <button class="current" aria-current="page"><span class="bottom-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg></span><span>Notes</span></button>
        <button @onclick='() => Navigation.NavigateTo("/settings")'><span class="bottom-icon profile-icon" aria-hidden="true">♙</span><span>Profile</span></button>
    </nav>
</div>

@code {
    private IReadOnlyList<CourseNoteRecord> CourseNotes = [];
    private static readonly string[] AttendanceStatuses = ["Present", "Absent", "Asynchronous"];
    private int? EditingNoteId;
    private string? SelectedCourseCode;
    private string? SelectedCourseTitle;
    private IEnumerable<CourseNoteRecord> SelectedCourseNotes => CourseNotes
        .Where(note => note.CourseCode == SelectedCourseCode && note.CourseTitle == SelectedCourseTitle)
        .OrderByDescending(note => note.ClassDate);
    private string EditText = "";
    private string EditNews = "";
    private string EditCreatedAt = "";
    private string? EditAttendance;
    private byte[]? EditImageData;
    private string? EditImageContentType;
    private string? EditError;
    private string? EditImagePreview => EditImageData is not null && EditImageContentType is not null
        ? $"data:{EditImageContentType};base64,{Convert.ToBase64String(EditImageData)}" : null;

    protected override async Task OnInitializedAsync() => await LoadCourseNotesAsync();

    private async Task LoadCourseNotesAsync() => CourseNotes = (await Data.GetCourseNotesAsync())
        .Where(note => !string.IsNullOrWhiteSpace(note.Text)
            || !string.IsNullOrWhiteSpace(note.News)
            || note.ImageData is not null)
        .ToList();

    private void SelectCourse(string courseCode, string courseTitle)
    {
        SelectedCourseCode = courseCode;
        SelectedCourseTitle = courseTitle;
        EditingNoteId = null;
    }

    private void ClearSelectedCourse()
    {
        SelectedCourseCode = null;
        SelectedCourseTitle = null;
        EditingNoteId = null;
    }

    private static string GetSubjectColor(string courseCode)
    {
        var paletteIndex = 1 + courseCode.ToUpperInvariant().Sum(character => character) % 10;
        return ScheduleColorPalette.ForRecordId(paletteIndex);
    }

    private void OpenEdit(CourseNoteRecord note)
    {
        EditingNoteId = note.Id;
        EditText = note.Text;
        EditNews = note.News ?? "";
        EditCreatedAt = note.CreatedAtText;
        EditAttendance = note.AttendanceStatus;
        EditImageData = note.ImageData;
        EditImageContentType = note.ImageContentType;
        EditError = null;
    }

    private async Task SaveEditAsync(int noteId)
    {
        try
        {
            await Data.UpdateCourseNoteAsync(noteId, EditText, EditNews, EditCreatedAt,
                EditAttendance, EditImageData, EditImageContentType);
            await LoadCourseNotesAsync();
            if (SelectedCourseCode is not null && !SelectedCourseNotes.Any())
                ClearSelectedCourse();
            CancelEdit();
        }
        catch (Exception exception) { EditError = exception.Message; }
    }

    private void CancelEdit() => EditingNoteId = null;

    private async Task LoadEditImageAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase) || file.Size > 5 * 1024 * 1024)
        {
            EditError = "Choose an image no larger than 5 MB.";
            return;
        }
        await using var input = file.OpenReadStream(5 * 1024 * 1024);
        using var output = new MemoryStream();
        await input.CopyToAsync(output);
        EditImageData = output.ToArray();
        EditImageContentType = file.ContentType;
        EditError = null;
    }

    private void RemoveEditImage() { EditImageData = null; EditImageContentType = null; }
}
