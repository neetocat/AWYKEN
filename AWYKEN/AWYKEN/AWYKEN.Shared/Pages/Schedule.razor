@page "/schedule"
@using AWYKEN.Shared.Components
@using AWYKEN.Shared.Data
@using AWYKEN.Shared.Models
@using System.Text.RegularExpressions
@inject AWYKEN.Shared.Services.DashboardState State
@inject IAwykenDataService Data
@inject NavigationManager Navigation

<PageTitle>AWYKEN</PageTitle>

<div class="schedule-app-shell">
    <main class="schedule-scroll">
        <div class="schedule-page">

            <header class="schedule-header app-page-header">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="AWYKEN logo" />
                </div>

                <div class="schedule-header-copy">
                    <h1>Schedule</h1>
                    <p>@HeaderDateRange</p>
                </div>

                <button class="schedule-add"
                        aria-label="Add a class"
                        @onclick='() => Navigation.NavigateTo("/add-class")'>
                    <img class="schedule-add-icon" src="_content/AWYKEN.Shared/images/icon/awyken-plus-icon.png" alt="AWYKEN's Add Icon'" />
                </button>
            </header>

            <div class="schedule-view-toggle" role="tablist" aria-label="Schedule view">
                <button class="@(ViewMode == "Day" ? "selected" : "")"
                        role="tab"
                        aria-selected="@(ViewMode == "Day")"
                        @onclick='() => SetViewModeAsync("Day")'>
                    Day
                </button>

                <button class="@(ViewMode == "Week" ? "selected" : "")"
                        role="tab"
                        aria-selected="@(ViewMode == "Week")"
                        @onclick='() => SetViewModeAsync("Week")'>
                    Week
                </button>
                <button class="@(ViewMode == "Month" ? "selected" : "")"
                        role="tab"
                        aria-selected="@(ViewMode == "Month")"
                        @onclick='() => SetViewModeAsync("Month")'>
                    Month
                </button>
            </div>

            @if (ViewMode != "Month")
            {
            <div class="schedule-date-strip" aria-label="Choose a day">
                @foreach (var day in WeekDays)
                {
                    var active = day == SelectedDate;

                    <button class="schedule-date @(active ? "active" : "")"
                            aria-pressed="@active"
                            @onclick="() => SelectDateAsync(day)">
                        <span>@day.ToString("ddd")[..1]</span>
                        <strong>@day.Day</strong>
                    </button>
                }
            </div>
            }

            @if (ViewMode == "Month")
            {
                <section class="month-calendar" aria-label="Monthly class calendar">
                    <div class="month-calendar-heading">
                        <button type="button" aria-label="Previous month" @onclick="() => ChangeMonthAsync(-1)">‹</button>
                        <h2>@DisplayedMonth.ToString("MMMM yyyy")</h2>
                        <button type="button" aria-label="Next month" @onclick="() => ChangeMonthAsync(1)">›</button>
                    </div>
                    <div class="month-weekdays" aria-hidden="true">
                        @foreach (var weekday in MonthWeekdays) { <span>@weekday</span> }
                    </div>
                    <div class="month-grid">
                        @foreach (var day in MonthDates)
                        {
                            var dayClasses = ClassesOn(day).ToList();
                            <div
                                    class="month-day @(day.Month == DisplayedMonth.Month ? "in-month" : "outside-month") @(day == SelectedDate ? "selected-day" : "") @(day == DateOnly.FromDateTime(DateTime.Today) ? "today" : "")"
                                    @onclick="() => OpenMonthDayAsync(day)">
                                <span class="month-day-number" aria-label="@day.ToString("dddd, MMMM d")">@day.Day</span>
                                <span class="month-day-events">
                                    @foreach (var item in dayClasses.Take(3))
                                    {
                                        <button type="button" class="month-class-chip"
                                              style="--event-accent: @(string.IsNullOrWhiteSpace(item.ColorCode) ? "#5268ca" : item.ColorCode)"
                                              title="@($"{item.CourseCode} · {item.Title} · {item.DisplayTimes}")"
                                              @onclick="() => OpenMonthClassAsync(item, day)"
                                              @onclick:stopPropagation="true">
                                            @item.CourseCode
                                        </button>
                                    }
                                    @if (dayClasses.Count > 3) { <span class="month-more">+@(dayClasses.Count - 3) more</span> }
                                </span>
                            </div>
                        }
                    </div>
                </section>
            }
            else if (ViewMode == "Week")
            {
                <section class="week-calendar" aria-label="Weekly class timetable">
                    <div class="week-calendar-grid" style="--timeline-hours: @TimelineHours; --timeline-height: @(TimelineHours * CalendarHourHeight)px">
                        <div class="week-time-axis" aria-hidden="true">
                            @for (var hour = TimelineStartHour; hour <= TimelineEndHour; hour += 2)
                            {
                                <span class="week-time-label" style="top: @((hour - TimelineStartHour) * CalendarHourHeight)px">
                                    @FormatTimelineHour(hour)
                                </span>
                            }
                        </div>

                        @foreach (var day in WeekDays)
                        {
                            <div class="week-day-track" aria-label="@day.ToString("dddd, MMMM d")">
                                @foreach (var block in WeekClassBlocksOn(day))
                                {
                                    <button type="button"
                                            class="week-event"
                                            style="--event-accent: @(string.IsNullOrWhiteSpace(block.Item.ColorCode) ? "#5268ca" : block.Item.ColorCode); top: @(GetEventTop(block))px; height: @(GetEventHeight(block))px"
                                            aria-label="@($"{block.Item.CourseCode}, {block.Item.Title}, {block.DisplayTimes}, {day:dddd}")"
                                            title="@($"{block.Item.CourseCode} · {block.Item.Title} · {block.DisplayTimes}")"
                                            @onclick="() => OpenWeekClassAsync(block.Item, day)">
                                        @block.Item.CourseCode
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    @if (!HasWeekdayClasses)
                    {
                        <p class="schedule-empty week-empty">No classes scheduled for this week.</p>
                    }
                </section>
            }
            else if (State.Schedule.Count == 0)
            {
                <p class="schedule-empty">No classes scheduled for this day. Select another day or click + to add a class.</p>
            }
            else
            {
                <section class="schedule-events" aria-label="Classes">
                    @foreach (var item in State.Schedule.OrderBy(item => ParseTime(item.StartTime)))
                    {
                        <article class="schedule-event" @key="item.Id">
                            <div class="event-time-label">
                                @item.Time @item.Period
                            </div>

                            <div class="event-card" style="--event-accent: @(string.IsNullOrWhiteSpace(item.ColorCode) ? "#5268ca" : item.ColorCode)">
                                <div class="event-main">
                                    <p class="event-course-code">@item.CourseCode</p>
                                    <h2><button type="button" class="event-title-edit" @onclick="() => OpenEditForm(item, SelectedDate)">@item.Title</button></h2>

                                    <div class="event-details">
                                        <span>
                                            <span class="detail-icon" aria-hidden="true">◷</span>
                                            @item.DisplayTimes
                                        </span>
                                        <span>
                                            <span class="detail-icon pin-icon" aria-hidden="true">⌖</span>
                                            @item.Location
                                        </span>
                                    </div>

                                    <div class="event-cor-meta">
                                        @if (!string.IsNullOrWhiteSpace(item.Section)) { <span>@item.Section</span> }
                                        @if (item.Units is decimal units) { <span>@units units</span> }
                                        @if (!string.IsNullOrWhiteSpace(item.Days)) { <span>@item.Days</span> }
                                    </div>

                                    <div class="event-instructor">
                                        <span class="instructor-avatar">@item.InstructorInitials</span>
                                        <span>@item.Instructor</span>
                                    </div>

                                </div>

                                <span class="event-mode @(item.Mode == "Online" ? "online" : "in-person")">
                                    @item.Mode
                                </span>
                            </div>
                        </article>
                    }
                </section>
            }
        </div>
    </main>

    <nav class="schedule-bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'>
            <span class="bottom-icon home-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span>
            <span>Home</span>
        </button>

        <button class="current" aria-current="page">
            <span class="bottom-icon calendar-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span>
            <span>Schedule</span>
        </button>

        <button class="add-nav-item" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'>
            <span class="add-button">+</span><span class="nav-label">Add</span>
        </button>

        <button @onclick='() => Navigation.NavigateTo("/notes")'>
            <span class="bottom-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg></span>
            <span>Notes</span>
        </button>

        <button @onclick='() => Navigation.NavigateTo("/settings")'>
            <span class="bottom-icon profile-icon" aria-hidden="true">♙</span>
            <span>Profile</span>
        </button>
    </nav>
</div>

@if (ShowForm)
{
    <ClassForm Draft="Draft"
               FormTitle="@FormTitle"
               Error="@FormError"
               OccurrenceDate="EditingOccurrenceDate"
               OnSave="SaveClass"
               OnSaveNotes="SaveNotes"
               OnCancel="CloseForm"
               CanDelete="@(EditingId is not null)"
               OnDelete="DeleteEditingClass" />
}

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="schedule-toast-backdrop" @onclick="DismissMessage">
        <section class="schedule-message"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@MessageTitle"
                 @onclick:stopPropagation="true">

            <h2>@MessageTitle</h2>
            <p>@Message</p>
            <button @onclick="DismissMessage">Got it</button>
        </section>
    </div>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "add")]
    public bool? AddRequested { get; set; }

    private readonly DateOnly WeekStart =
        StartOfWeek(DateOnly.FromDateTime(DateTime.Today));

    private const int CalendarHourHeight = 44;
    private DateOnly SelectedDate = InitialSelectedDate();
    private DateOnly EditingOccurrenceDate = InitialSelectedDate();
    private DateOnly DisplayedMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string ViewMode = "Day";
    private string HeaderDateRange => ViewMode switch
    {
        "Month" => DisplayedMonth.ToString("MMMM yyyy"),
        "Day" => SelectedDate.ToString("ddd, MMM d"),
        _ => WeekDateRange
    };
    private string WeekDateRange
    {
        get
        {
            var weekEnd = WeekStart.AddDays(6);
            return WeekStart.Month == weekEnd.Month && WeekStart.Year == weekEnd.Year
                ? $"{WeekStart:MMMM d}–{weekEnd.Day}"
                : $"{WeekStart:MMMM d}–{weekEnd:MMMM d}";
        }
    }

    private bool HasWeekdayClasses => WeekDays.Any(day => ClassesOn(day).Any());

    private bool ShowForm;
    private string FormTitle = "Add Class";
    private string? EditingId;
    private string? FormError;
    private bool handledAddRequest;
    private AWYKEN.Shared.Services.ScheduleItem? EditingItem;

    private string? MessageTitle;
    private string? Message;

    private ClassDraft Draft = new();

    private IEnumerable<DateOnly> WeekDays =>
        Enumerable.Range(0, 5).Select(offset => WeekStart.AddDays(offset));

    private static readonly string[] MonthWeekdays = ["M", "T", "W", "T", "F", "S", "S"];
    private int MonthLeadingDays => ((int)DisplayedMonth.DayOfWeek + 6) % 7;
    private int MonthCellCount => (int)Math.Ceiling((MonthLeadingDays + DateTime.DaysInMonth(DisplayedMonth.Year, DisplayedMonth.Month)) / 7d) * 7;
    private IEnumerable<DateOnly> MonthDates => Enumerable.Range(0, MonthCellCount)
        .Select(offset => DisplayedMonth.AddDays(offset - MonthLeadingDays));

    private int TimelineStartHour => State.Schedule
        .SelectMany(GetMeetingRanges)
        .Select(range => range.Start.Hour)
        .Append(7)
        .Min();

    private int TimelineEndHour => State.Schedule
        .SelectMany(GetMeetingRanges)
        .Select(range => range.End.Hour + (range.End.Minute > 0 ? 1 : 0))
        .Append(17)
        .Max();

    private int TimelineHours => Math.Max(1, TimelineEndHour - TimelineStartHour);

    // Load the selected day's classes from the same SQLite-backed shared state.
    protected override Task OnInitializedAsync() => RefreshSelectedViewAsync();

    private async Task SelectDateAsync(DateOnly date)
    {
        SelectedDate = date;
        await RefreshSelectedViewAsync();
    }

    private async Task SetViewModeAsync(string mode)
    {
        ViewMode = mode;
        if (mode == "Month")
            DisplayedMonth = new DateOnly(SelectedDate.Year, SelectedDate.Month, 1);
        await RefreshSelectedViewAsync();
    }

    private Task RefreshSelectedViewAsync() => ViewMode switch
    {
        "Week" => Data.RefreshWeekAsync(WeekStart),
        "Month" => Data.RefreshMonthAsync(DisplayedMonth),
        _ => Data.RefreshAsync(SelectedDate)
    };

    private async Task ChangeMonthAsync(int amount)
    {
        DisplayedMonth = DisplayedMonth.AddMonths(amount);
        SelectedDate = DisplayedMonth;
        await Data.RefreshMonthAsync(DisplayedMonth);
    }

    private async Task OpenMonthDayAsync(DateOnly day)
    {
        SelectedDate = day;
        DisplayedMonth = new DateOnly(day.Year, day.Month, 1);
        ViewMode = "Day";
        await Data.RefreshAsync(day);
    }

    private async Task OpenMonthClassAsync(AWYKEN.Shared.Services.ScheduleItem item, DateOnly day)
    {
        SelectedDate = day;
        await OpenEditForm(item, day);
    }

    private async Task OpenWeekClassAsync(AWYKEN.Shared.Services.ScheduleItem item, DateOnly day)
    {
        SelectedDate = day;
        await OpenEditForm(item, day);
    }

    protected override void OnParametersSet()
    {
        if (AddRequested == true && !handledAddRequest)
        {
            handledAddRequest = true;
            OpenAddForm();
        }
    }

    private static DateOnly StartOfWeek(DateOnly date) =>
        date.AddDays(-(((int)date.DayOfWeek + 6) % 7));

    private static DateOnly InitialSelectedDate()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        return today.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday
            ? StartOfWeek(today)
            : today;
    }

    private static DateTime ParseTime(string time)
    {
        return DateTime.TryParse(time, out var parsed)
            ? parsed
            : DateTime.MinValue;
    }

    private static string To24HourTime(string time)
    {
        return DateTime.TryParse(time, out var parsed)
            ? parsed.ToString("HH:mm")
            : "";
    }

    private IEnumerable<AWYKEN.Shared.Services.ScheduleItem> ClassesOn(DateOnly day) =>
        State.Schedule
            .Where(item => item.ScheduledDate == day
                || (item.ScheduledDate is null && IsScheduledOn(item, day)))
            .OrderBy(item => ParseTime(item.StartTime));

    private IEnumerable<WeekCalendarEvent> WeekClassBlocksOn(DateOnly day) =>
        ClassesOn(day)
            .GroupBy(item => (
                CourseCode: item.CourseCode.Trim().ToUpperInvariant(),
                Title: item.Title.Trim().ToUpperInvariant(),
                Section: item.Section?.Trim().ToUpperInvariant() ?? ""))
            .Select(group =>
            {
                var item = group.First();
                var ranges = group.SelectMany(GetMeetingRanges)
                    .Distinct()
                    .OrderBy(range => range.Start)
                    .ToList();
                var start = ranges.Min(range => range.Start);
                var end = ranges.Max(range => range.End);
                var displayTimes = string.Join(", ", ranges.Select(range =>
                    $"{range.Start.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)}–{range.End.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)}"));

                return new WeekCalendarEvent(item, start, end, displayTimes);
            })
            .OrderBy(block => block.Start);

    private static IEnumerable<(TimeOnly Start, TimeOnly End)> GetMeetingRanges(
        AWYKEN.Shared.Services.ScheduleItem item)
    {
        var matches = Regex.Matches(item.DisplayTimes,
            @"(?<start>\d{1,2}:\d{2}\s*(?:AM|PM))\s*(?:-|–|—|to)\s*(?<end>\d{1,2}:\d{2}\s*(?:AM|PM))",
            RegexOptions.IgnoreCase);

        foreach (Match match in matches)
        {
            if (TryGetTime(match.Groups["start"].Value, out var start)
                && TryGetTime(match.Groups["end"].Value, out var end))
                yield return (start, end);
        }

        if (matches.Count == 0)
        {
            var start = TryGetTime(item.StartTime, out var fallbackStart)
                ? fallbackStart
                : new TimeOnly(7, 0);
            var end = TryGetTime(item.EndTime, out var fallbackEnd)
                ? fallbackEnd
                : start.AddMinutes(30);
            yield return (start, end < start ? start.AddMinutes(30) : end);
        }
    }

    private static bool IsScheduledOn(
        AWYKEN.Shared.Services.ScheduleItem item, DateOnly day) =>
        !string.IsNullOrWhiteSpace(item.Days)
            && item.Days.Split([',', '|', ' '], StringSplitOptions.RemoveEmptyEntries)
                .Any(name => name.StartsWith(day.ToString("ddd"), StringComparison.OrdinalIgnoreCase));

    private static bool TryGetTime(string value, out TimeOnly time) =>
        TimeOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture, out time);

    private int GetEventTop(WeekCalendarEvent block)
    {
        var minutesFromStart = block.Start.Hour * 60 + block.Start.Minute - TimelineStartHour * 60;
        return Math.Max(0, (int)Math.Round(minutesFromStart * (double)CalendarHourHeight / 60));
    }

    private int GetEventHeight(WeekCalendarEvent block)
    {
        var durationMinutes = Math.Max(30, (int)(block.End - block.Start).TotalMinutes);
        return Math.Max(30, (int)Math.Round(durationMinutes * (double)CalendarHourHeight / 60));
    }

    private sealed record WeekCalendarEvent(
        AWYKEN.Shared.Services.ScheduleItem Item, TimeOnly Start, TimeOnly End, string DisplayTimes);

    private static string FormatTimelineHour(int hour)
    {
        var normalizedHour = hour % 24;
        var suffix = normalizedHour < 12 ? "AM" : "PM";
        var displayHour = normalizedHour % 12;
        return $"{(displayHour == 0 ? 12 : displayHour)} {suffix}";
    }

    private void OpenAddForm()
    {
        Draft = new ClassDraft();
        EditingId = null;
        EditingItem = null;
        FormTitle = "Add Class";
        FormError = null;
        ShowForm = true;
    }

    private async Task OpenEditForm(AWYKEN.Shared.Services.ScheduleItem item, DateOnly occurrenceDate)
    {
        // Capture the exact calendar occurrence so async loads/saves cannot fall back to the class's original date.
        EditingOccurrenceDate = occurrenceDate;
        EditingId = item.Id;
        EditingItem = item;
        FormTitle = "Edit Class";
        FormError = null;

        Draft = new ClassDraft
        {
            CourseCode = item.CourseCode,
            Title = item.Title,
            StartTime = To24HourTime(item.StartTime),
            EndTime = To24HourTime(item.EndTime),
            Location = item.Location,
            Instructor = item.Instructor,
            Mode = item.Mode,
            CreatedAtText = DateTime.Now.ToString("yyyy-MM-dd HH:mm"),
            Notes = ""
        };

        // Notes are loaded for this selected class date, so recurring meetings keep separate notes.
        var note = await Data.GetCourseNoteAsync(item.Id, EditingOccurrenceDate);
        if (note is not null)
        {
            Draft.Notes = note.Text;
            Draft.News = note.News ?? "";
            Draft.AttendanceStatus = note.AttendanceStatus;
            Draft.CreatedAtText = note.CreatedAtText;
            Draft.ImageData = note.ImageData;
            Draft.ImageContentType = note.ImageContentType;
        }

        ShowForm = true;
    }

    private async Task SaveNotes()
    {
        if (EditingItem is null) return;
        try
        {
            // A note belongs to the occurrence the user opened, even when its class row
            // was originally imported as a one-time schedule record.
            var classDate = EditingOccurrenceDate;
            await Data.SaveCourseNoteAsync(EditingItem.Id, classDate, Draft.Notes,
                Draft.News, Draft.CreatedAtText, Draft.AttendanceStatus, Draft.ImageData, Draft.ImageContentType);
            await RefreshSelectedViewAsync();
            CloseForm();
            ShowMessage("Notes saved", "Your notes and attendance were saved for this date.");
        }
        catch (Exception exception)
        {
            FormError = exception.Message;
        }
    }

    private async Task SaveClass()
    {
        if (!Draft.TryValidate(out var start, out var end, out var error))
        {
            FormError = error;
            return;
        }

        var startTime = DateTime.Today.Add(start).ToString("h:mm tt");
        var endTime = DateTime.Today.Add(end).ToString("h:mm tt");

        var initials = string.Join("",
            Draft.Instructor.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));

        var newItem = new AWYKEN.Shared.Services.ScheduleItem(
            EditingId ?? Guid.NewGuid().ToString(),
            Draft.CourseCode.Trim(),
            Draft.Title.Trim(),
            startTime,
            endTime,
            Draft.Location.Trim(),
            Draft.Instructor.Trim(),
            initials,
            Draft.Mode,
            EditingItem?.ColorCode ?? "#5268ca",
            EditingItem?.Link,
            EditingItem?.Cfn,
            EditingItem?.Section,
            EditingItem?.Units,
            EditingItem?.Days,
            EditingItem?.MeetingTimes,
            EditingItem?.ScheduledDate
        );

        try
        {
            // Persist edits and additions; refresh updates the same shared state
            // that Home, Commute, and Notifications read.
            await Data.SaveScheduleItemAsync(newItem, EditingItem?.ScheduledDate ?? SelectedDate);
            await RefreshSelectedViewAsync();
        }
        catch (Exception exception)
        {
            FormError = exception.Message;
            return;
        }

        CloseForm();
        ShowMessage(
            "Success",
            EditingId is null
                ? "Class added successfully."
                : "Class updated successfully."
        );
    }

    private Task DeleteEditingClass()
    {
        if (EditingItem is null)
            return Task.CompletedTask;

        var id = EditingItem.Id;
        CloseForm();
        return DeleteClass(id);
    }

    private async Task DeleteClass(string id)
    {
        try
        {
            await Data.DeleteScheduleItemAsync(id, SelectedDate);
            await RefreshSelectedViewAsync();
            ShowMessage("Class deleted", "The class was removed from your schedule.");
        }
        catch (Exception exception)
        {
            ShowMessage("Could not delete class", exception.Message);
        }
    }

    private void CloseForm()
    {
        ShowForm = false;
        FormError = null;
    }

    private void ShowMessage(string title, string message)
    {
        MessageTitle = title;
        Message = message;
    }

    private void DismissMessage()
    {
        MessageTitle = null;
        Message = null;
    }
}
