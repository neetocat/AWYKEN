@page "/schedule"
@inject AWYKEN.Shared.Services.DashboardState State
@inject NavigationManager Navigation

<PageTitle>AWYKEN • Schedule</PageTitle>

<div class="schedule-app-shell">
    <main class="schedule-scroll">
        <div class="schedule-page">

            <header class="schedule-header">
                <div class="schedule-brand" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>

                <div class="schedule-header-copy">
                    <h1>Schedule</h1>
                    <p>@WeekStart.ToString("MMMM d")–@WeekStart.AddDays(6).Day</p>
                </div>

                <button class="schedule-add"
                        aria-label="Add a class"
                        @onclick="OpenAddForm">
                    +
                </button>
            </header>

            <div class="schedule-view-toggle" role="tablist" aria-label="Schedule view">
                <button class="@(ViewMode == "Day" ? "selected" : "")"
                        role="tab"
                        aria-selected="@(ViewMode == "Day")"
                        @onclick='() => ViewMode = "Day"'>
                    Day
                </button>

                <button class="@(ViewMode == "Week" ? "selected" : "")"
                        role="tab"
                        aria-selected="@(ViewMode == "Week")"
                        @onclick='() => ViewMode = "Week"'>
                    Week
                </button>
            </div>

            <div class="schedule-date-strip" aria-label="Choose a day">
                @foreach (var day in WeekDays)
                {
                    var active = day == SelectedDate;

                    <button class="schedule-date @(active ? "active" : "")"
                            aria-pressed="@active"
                            @onclick="() => SelectedDate = day">
                        <span>@day.ToString("ddd").Substring(0, 1)</span>
                        <strong>@day.Day</strong>
                    </button>
                }
            </div>

            @if (ViewMode == "Week")
            {
                <p class="week-view-note">
                    Your classes for the week of @WeekStart.ToString("MMMM d")
                </p>
            }

            <section class="schedule-events" aria-label="Classes">
                @if (State.Schedule.Count == 0)
                {
                    <p>No classes yet. Click + to add your first class!</p>
                }
                else
                {
                    @foreach (var item in State.Schedule.OrderBy(item => ParseTime(item.StartTime)))
                    {
                        <article class="schedule-event" @key="item.Id">

                            <div class="event-time-label">
                                @item.Time @item.Period
                            </div>

                            <div class="event-card"
                                 style="--event-accent: @item.ColorCode">

                                <div class="event-main">
                                    <p class="event-course-code">@item.CourseCode</p>

                                    <h2>@item.Title</h2>

                                    <div class="event-details">
                                        <span>
                                            <span class="detail-icon" aria-hidden="true">◷</span>
                                            @item.StartTime–@item.EndTime
                                        </span>

                                        <span>
                                            <span class="detail-icon pin-icon" aria-hidden="true">⌖</span>
                                            @item.Location
                                        </span>
                                    </div>

                                    <div class="event-instructor">
                                        <span class="instructor-avatar">
                                            @item.InstructorInitials
                                        </span>
                                        <span>@item.Instructor</span>
                                    </div>

                                    <div class="class-actions">
                                        <button type="button"
                                                @onclick="() => OpenEditForm(item)">
                                            Edit
                                        </button>

                                        <button type="button"
                                                @onclick="() => DeleteClass(item.Id)">
                                            Delete
                                        </button>
                                    </div>
                                </div>

                                <span class="event-mode @(item.Mode == "Online" ? "online" : "in-person")">
                                    @item.Mode
                                </span>
                            </div>
                        </article>
                    }
                }
            </section>
        </div>
    </main>

    <nav class="schedule-bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'>
            <span class="bottom-icon home-icon" aria-hidden="true">⌂</span>
            <span>Home</span>
        </button>

        <button class="current" aria-current="page">
            <span class="bottom-icon calendar-icon" aria-hidden="true">▦</span>
            <span>Schedule</span>
        </button>

        <button class="add-nav" aria-label="Add" @onclick="OpenAddForm">
            <span class="add-nav-circle">+</span>
            <span>Add</span>
        </button>

        <button @onclick='() => Navigation.NavigateTo("/notification")'>
            <span class="bottom-icon alert-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                </svg>
            </span>
            <span>Alerts</span>
        </button>

        <button @onclick='() => ShowMessage("Profile", "Profile settings will appear here.")'>
            <span class="bottom-icon profile-icon" aria-hidden="true">♙</span>
            <span>Profile</span>
        </button>
    </nav>
</div>

@if (ShowForm)
{
    <div class="class-form-backdrop">
        <section class="class-form" role="dialog" aria-modal="true"
                 aria-label="@FormTitle">

            <h2>@FormTitle</h2>
            <p>Enter your class information below.</p>

            @if (!string.IsNullOrWhiteSpace(FormError))
            {
                <p class="class-form-error">@FormError</p>
            }

            <label for="courseCode">Course Code</label>
            <input id="courseCode" @bind="Draft.CourseCode"
                   placeholder="e.g. CS 2203" />

            <label for="courseTitle">Course Name</label>
            <input id="courseTitle" @bind="Draft.Title"
                   placeholder="e.g. Data Structures" />

            <label for="startTime">Start Time</label>
            <input id="startTime" type="time"
                   value="@Draft.StartTime"
                   @onchange="e => Draft.StartTime = e.Value?.ToString() ?? string.Empty" />

            <label for="endTime">End Time</label>
            <input id="endTime" type="time"
                   value="@Draft.EndTime"
                   @onchange="e => Draft.EndTime = e.Value?.ToString() ?? string.Empty" />

            <label for="classLocation">Room / Location</label>
            <input id="classLocation" @bind="Draft.Location"
                   placeholder="e.g. Room 204 or Google Meet" />

            <label for="instructor">Instructor</label>
            <input id="instructor" @bind="Draft.Instructor"
                   placeholder="e.g. Juan Dela Cruz" />

            <label for="classMode">Class Mode</label>
            <select id="classMode" @bind="Draft.Mode">
                <option value="Face-to-face">Face-to-face</option>
                <option value="Online">Online</option>
            </select>

            <div class="class-form-actions">
                <button type="button" @onclick="SaveClass">Save Class</button>
                <button type="button" @onclick="CloseForm">Cancel</button>
            </div>
        </section>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="schedule-toast-backdrop" @onclick="DismissMessage">
        <section class="schedule-message"
                 role="dialog"
                 aria-modal="true"
                 aria-label="@MessageTitle"
                 @onclick:stopPropagation="true">

            <h2>@MessageTitle</h2>
            <p>@Message</p>
            <button @onclick="DismissMessage">Got it</button>
        </section>
    </div>
}

<style>
    .class-form-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1000;
        background: rgba(0, 0, 0, 0.55);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 16px;
        overflow-y: auto;
    }

    .class-form {
        background: white;
        color: #222;
        width: 100%;
        max-width: 460px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 24px;
        border-radius: 16px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.2);
    }

        .class-form h2 {
            margin-top: 0;
            margin-bottom: 6px;
        }

        .class-form label {
            display: block;
            margin-top: 12px;
            margin-bottom: 5px;
            font-weight: 600;
            font-size: 14px;
        }

        .class-form input,
        .class-form select {
            display: block;
            width: 100%;
            box-sizing: border-box;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font: inherit;
            background: white;
            color: #222;
        }

    .class-form-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

        .class-form-actions button,
        .class-actions button {
            padding: 9px 14px;
            border: 0;
            border-radius: 8px;
            cursor: pointer;
        }

            .class-form-actions button:first-child {
                background: #5268ca;
                color: white;
            }

            .class-form-actions button:last-child {
                background: #e8e8e8;
                color: #222;
            }

    .class-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

        .class-actions button {
            background: #eeeeee;
            color: #222;
        }

    .class-form-error {
        padding: 10px;
        background: #ffe5e5;
        color: #a00000;
        border-radius: 8px;
    }
</style>

@code {
    private readonly DateOnly WeekStart =
        StartOfWeek(DateOnly.FromDateTime(DateTime.Today));

    private DateOnly SelectedDate = InitialSelectedDate();
    private string ViewMode = "Day";

    private bool ShowForm;
    private string FormTitle = "Add Class";
    private string? EditingId;
    private string? FormError;

    private string? MessageTitle;
    private string? Message;

    [Parameter]
    [SupplyParameterFromQuery(Name = "add")]
    public bool? AddRequested { get; set; }

    private bool handledAddRequest;

    protected override void OnParametersSet()
    {
        if (AddRequested == true && !handledAddRequest)
        {
            handledAddRequest = true;
            OpenAddForm();
        }
    }

    private ClassDraft Draft = new();

    private IEnumerable<DateOnly> WeekDays =>
        Enumerable.Range(0, 5).Select(offset => WeekStart.AddDays(offset));

    private static DateOnly StartOfWeek(DateOnly date) =>
        date.AddDays(-(((int)date.DayOfWeek + 6) % 7));

    private static DateOnly InitialSelectedDate()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        return today.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday
            ? StartOfWeek(today)
            : today;
    }

    private static DateTime ParseTime(string time)
    {
        return DateTime.TryParse(time, out var parsed)
            ? parsed
            : DateTime.MinValue;
    }

    private void OpenAddForm()
    {
        Draft = new ClassDraft();
        EditingId = null;
        FormTitle = "Add Class";
        FormError = null;
        ShowForm = true;
    }

    private void OpenEditForm(AWYKEN.Shared.Services.ScheduleItem item)
    {
        EditingId = item.Id;
        FormTitle = "Edit Class";
        FormError = null;

        Draft = new ClassDraft
        {
            CourseCode = item.CourseCode,
            Title = item.Title,
            StartTime = To24HourTime(item.StartTime),
            EndTime = To24HourTime(item.EndTime),
            Location = item.Location,
            Instructor = item.Instructor,
            Mode = item.Mode
        };

        ShowForm = true;
    }

    private static string To24HourTime(string time)
    {
        return DateTime.TryParse(time, out var parsed)
            ? parsed.ToString("HH:mm")
            : "";
    }

    private void SaveClass()
    {
        if (string.IsNullOrWhiteSpace(Draft.CourseCode) ||
            string.IsNullOrWhiteSpace(Draft.Title) ||
            string.IsNullOrWhiteSpace(Draft.StartTime) ||
            string.IsNullOrWhiteSpace(Draft.EndTime) ||
            string.IsNullOrWhiteSpace(Draft.Location) ||
            string.IsNullOrWhiteSpace(Draft.Instructor))
        {
            FormError = "Please fill in all fields.";
            return;
        }

        if (!TimeSpan.TryParse(Draft.StartTime, out var start) ||
            !TimeSpan.TryParse(Draft.EndTime, out var end))
        {
            FormError = "Please enter valid start and end times.";
            return;
        }

        if (end <= start)
        {
            FormError = "End time must be later than start time.";
            return;
        }

        var startTime = DateTime.Today.Add(start).ToString("h:mm tt");
        var endTime = DateTime.Today.Add(end).ToString("h:mm tt");

        var initials = string.Join("",
            Draft.Instructor.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));

        var newItem = new AWYKEN.Shared.Services.ScheduleItem(
            EditingId ?? Guid.NewGuid().ToString(),
            Draft.CourseCode.Trim(),
            Draft.Title.Trim(),
            startTime,
            endTime,
            Draft.Location.Trim(),
            Draft.Instructor.Trim(),
            initials,
            Draft.Mode,
            "#5268ca",
            null
        );

        if (EditingId is not null)
        {
            var index = State.Schedule.FindIndex(item => item.Id == EditingId);

            if (index >= 0)
            {
                State.Schedule[index] = newItem;
            }
        }
        else
        {
            State.Schedule.Add(newItem);
        }

        CloseForm();
        ShowMessage(
            "Success",
            EditingId is null
                ? "Class added successfully."
                : "Class updated successfully."
        );
    }

    private void DeleteClass(string id)
    {
        var item = State.Schedule.FirstOrDefault(item => item.Id == id);

        if (item is not null)
        {
            State.Schedule.Remove(item);
            ShowMessage("Class deleted", "The class was removed from your schedule.");
        }
    }

    private void CloseForm()
    {
        ShowForm = false;
        FormError = null;
    }

    private void ShowMessage(string title, string message)
    {
        MessageTitle = title;
        Message = message;
    }

    private void DismissMessage()
    {
        MessageTitle = null;
        Message = null;
    }

    private sealed class ClassDraft
    {
        public string CourseCode { get; set; } = "";
        public string Title { get; set; } = "";
        public string StartTime { get; set; } = "08:00";
        public string EndTime { get; set; } = "09:00";
        public string Location { get; set; } = "";
        public string Instructor { get; set; } = "";
        public string Mode { get; set; } = "Face-to-face";
    }
}