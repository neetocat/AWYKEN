@page "/admin"
@using AWYKEN.Shared.Data
@using AWYKEN.Shared.Services
@inject IAwykenDataService Data
@inject DashboardState State
@inject NavigationManager Navigation

<PageTitle>Admin - AWYKEN</PageTitle>

<div class="admin-shell">
    <header class="admin-header">
        <button class="admin-back"
                @onclick='() => Navigation.NavigateTo("/settings")'
                aria-label="Back to settings">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 18l-6-6 6-6" />
            </svg>
        </button>
        <div>
            <h1>Admin</h1>
            <p>Every account and saved record in the cloud database</p>
        </div>
    </header>

    @if (Error is not null)
    {
        <section class="admin-message admin-error" role="alert">
            <strong>The admin overview could not be loaded.</strong>
            <p>@Error</p>
        </section>
    }
    else if (Overview is null)
    {
        <p class="admin-message">Checking access…</p>
    }
    else
    {
        <section class="admin-stats" aria-label="Database totals">
            <article class="admin-stat">
                <span class="admin-stat-value">@Overview.AccountCount</span>
                <span class="admin-stat-label">Accounts</span>
            </article>
            <article class="admin-stat">
                <span class="admin-stat-value">@Overview.ClassCount</span>
                <span class="admin-stat-label">Classes</span>
            </article>
            <article class="admin-stat">
                <span class="admin-stat-value">@Overview.NoteCount</span>
                <span class="admin-stat-label">Notes</span>
            </article>
            <article class="admin-stat">
                <span class="admin-stat-value">@Overview.IncentiveCount</span>
                <span class="admin-stat-label">Incentives</span>
            </article>
        </section>

        <section class="admin-accounts" aria-label="Accounts">
            <h2>Accounts</h2>

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col" class="admin-number">Classes</th>
                            <th scope="col" class="admin-number">Notes</th>
                            <th scope="col" class="admin-number">Points</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in Overview.Accounts)
                        {
                            <tr>
                                <td>
                                    <span class="admin-name">@(account.DisplayName ?? "Guest")</span>
                                    @if (account.IsAdmin)
                                    {
                                        <span class="admin-badge">admin</span>
                                    }
                                </td>
                                <td class="admin-email">@(account.Email ?? "— guest profile —")</td>
                                <td class="admin-number">@account.ClassCount</td>
                                <td class="admin-number">@account.NoteCount</td>
                                <td class="admin-number">@account.IncentiveCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="admin-footnote">
                Signed in as <strong>@(State.User.Email ?? "unknown")</strong>.
                Passwords and teacher PINs are stored as salted hashes and are never shown here.
            </p>
        </section>
    }
</div>

@code {
    private AdminOverview? Overview;
    private string? Error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Data.InitializeAsync();

            // The guard runs on the server, so a non-admin never receives this page's data.
            if (!await Data.IsAdminAsync())
            {
                Navigation.NavigateTo("/settings", replace: true);
                return;
            }

            Overview = await Data.GetAdminOverviewAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
    }
}
