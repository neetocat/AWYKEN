@page "/add-class"
@inject NavigationManager Navigation

<PageTitle>AWYKEN</PageTitle>

<div class="add-class">
    <header class="add-class__header">
        <button class="add-class__button">‹</button>
        
        <div class="add-class__header-content">
            <h1 class="add-class__header-text add-class__button--back">Add class</h1>
            <p class="add-class__subheader-text">Create a new class schedule</p>
        </div>

        <button class="add-class__button add-class__button--save">Save</button>
    </header>

    <main class="add-class__main">
        <!-- CLASS DETAILS -->
        <h2 class="add-class__subtitle">Class Details</h2>

        <label class="add-class__input-label" for="subject-name">Subject Name</label>
        <input class="add-class__input-field" id="subject-name" type="text" name="subject-name" maxlength="100" placeholder="Enter subject name..." required />

        <label class="add-class__input-label" for="course-code">Course Code</label>
        <input class="add-class__input-field" id="course-code" type="text" name="course-code" maxlength="15" placeholder="e.g., MATH 101" required />

        <label class="add-class__input-label" for="instructor">Instructor (optional)</label>
        <input class="add-class__input-field" id="instructor" type="text" name="instructor" maxlength="50" placeholder="Enter instructor name..." />

        <!-- SCHEDULE -->
        <form class="add-class__form">
            <h2 class="add-class__subtitle">Schedule</h2>

            <div class="add-class__class-days-wrapper">
                <div class="add-class__class-day-option">M</div>
                <div class="add-class__class-day-option">T</div>
                <div class="add-class__class-day-option">W</div>
                <div class="add-class__class-day-option">TH</div>
                <div class="add-class__class-day-option">F</div>
                <div class="add-class__class-day-option">S</div>
                <div class="add-class__class-day-option">SU</div>
            </div>

            <div class="add-class__time-wrapper">
                <!-- Start Time -->
                <label class="add-class__input-label" for="start-time">Starts</label>
                <div class="add-class__time-input">
                    <img class="add-class__icon add__icon--clock add__icon--clock-large" src="_content/AWYKEN.Shared/images/icon/awyken-clock-icon.png" alt="AWYKEN Clock Icon" />
                    <input class="add-class__input-field add-class__input-field--time" id="start-time" name="start-time" type="time" required />
                    <img class="add-class__icon add__icon--clock add__icon--clock-small" src="_content/AWYKEN.Shared/images/icon/awyken-clock-icon.png" alt="AWYKEN Clock Icon" />
                </div>

                <!-- End Time -->
                <label class="add-class__input-label" for="end-time">Ends</label>
                <div class="add-class__time-input">
                    <img class="add-class__icon add__icon--clock add__icon--clock-large" src="_content/AWYKEN.Shared/images/icon/awyken-clock-icon.png" alt="AWYKEN Clock Icon" />
                    <input class="add-class__input-field add-class__input-field--time" id="end-time" name="end-time" type="time" required />
                    <img class="add-class__icon add__icon--clock add__icon--clock-small" src="_content/AWYKEN.Shared/images/icon/awyken-clock-icon.png" alt="AWYKEN Clock Icon" />
                </div>
            </div>
        </form>
    </main>
</div>

@code {

