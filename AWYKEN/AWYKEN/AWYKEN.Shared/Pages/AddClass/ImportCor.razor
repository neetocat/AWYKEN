@page "/import-cor"
@using AWYKEN.Shared.Services
@inject NavigationManager Navigation
@inject DashboardState State
@inject CorScheduleImporter Importer
@inject AWYKEN.Shared.Data.IAwykenDataService Data

<PageTitle>AWYKEN</PageTitle>

<div class="flow-shell import-screen">
    <main class="flow-scroll">
        <div class="flow-content">
            <header class="flow-header app-page-header">
                <button class="back-button" @onclick='() => Navigation.NavigateTo("/settings")' aria-label="Back">‹</button>
                <div><h1>Import your COR</h1><p>@(Data.IsAuthenticated ? "Step 2 of 3" : "Step 1 of 3")</p></div>
                <button class="outline-icon-button" aria-label="Notifications">♧</button>
            </header>

            <div class="stepper" aria-label="Import progress"><span class="@(Data.IsAuthenticated ? "complete" : "current")"></span><i></i><span class="@(Data.IsAuthenticated ? "current" : "")"></span><i></i><span></span></div>

            @if (!Data.IsAuthenticated)
            {
                <section class="import-auth-card">
                    <div class="scan-icon">✉</div>
                    <h2>Sign in before importing</h2>
                    <p>Use your AWYKEN email to connect this COR to your account. Your COR details will be saved to this signed-in profile.</p>
                    <div class="import-auth-mode"><button class="@(CreateAccount ? "" : "selected")" @onclick="() => CreateAccount = false">Log in</button><button class="@(CreateAccount ? "selected" : "")" @onclick="() => CreateAccount = true">Create account</button></div>
                    @if (CreateAccount)
                    {
                        <label class="import-auth-field">Name<input @bind="DisplayName" autocomplete="name" maxlength="100" /></label>
                    }
                    <label class="import-auth-field">Email<input type="email" @bind="Email" autocomplete="email" /></label>
                    <label class="import-auth-field">Password
                        <span class="password-input-wrap">
                            <input type="@(ShowPassword ? "text" : "password")" @bind="Password" autocomplete="@(CreateAccount ? "new-password" : "current-password")" />
                            <button type="button" class="password-visibility-toggle" aria-label="@(ShowPassword ? "Hide password" : "Show password")" aria-pressed="@ShowPassword" @onclick="() => ShowPassword = !ShowPassword">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" />@if (ShowPassword) { <path d="m4 4 16 16" /> }</svg>
                            </button>
                        </span>
                    </label>
                    @if (CreateAccount)
                    {
                        <label class="import-auth-field">Confirm password
                            <span class="password-input-wrap">
                                <input type="@(ShowConfirmPassword ? "text" : "password")" @bind="ConfirmPassword" autocomplete="new-password" />
                                <button type="button" class="password-visibility-toggle" aria-label="@(ShowConfirmPassword ? "Hide confirm password" : "Show confirm password")" aria-pressed="@ShowConfirmPassword" @onclick="() => ShowConfirmPassword = !ShowConfirmPassword">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" />@if (ShowConfirmPassword) { <path d="m4 4 16 16" /> }</svg>
                                </button>
                            </span>
                        </label>
                    }
                    @if (!string.IsNullOrWhiteSpace(status)) { <p class="import-account-error" role="alert">@status</p> }
                    <button class="import-auth-submit" disabled="@Working" @onclick="Authenticate">@(Working ? "Please wait…" : CreateAccount ? "Create account and continue" : "Log in and continue")</button>
                    <small>Your COR importer and review flow stay the same after sign-in.</small>
                </section>
            }
            else
            {
            <section class="import-intro">
                <div class="scan-icon">⌗<b>✦</b></div>
                <h2>Build your schedule<br />in one scan.</h2>
                <p>Upload your Certificate of Registration and we'll fill in the details<br class="desktop-only" /> for you.</p>
            </section>

            <section class="upload-card">
                <div class="upload-icon">⇧</div>
                <h2>Upload your registration form</h2>
                <p>PDF, JPG, PNG, BMP or TIFF · Max 10 MB</p>
                <InputFile OnChange="SelectFile" />
            </section>

            <aside class="tip-card"><strong>ⓘ</strong><div><b>For the best result</b><p>Use a clear, well-lit image with all four corners visible.</p></div></aside>
            <p class="manual-link">Can't scan your COR? <button @onclick="EnterManually">Enter classes manually</button></p>

            @if (!string.IsNullOrWhiteSpace(status))
            {
                <p class="flow-status" role="status">@status</p>
            }
            }
        </div>
    </main>
</div>

@code {
    private string? status;
    private bool CreateAccount;
    private bool Working;
    private bool ShowPassword;
    private bool ShowConfirmPassword;
    private string Email = "";
    private string Password = "";
    private string ConfirmPassword = "";
    private string DisplayName = "";
    private readonly string[] AllowedExtensions = { ".pdf", ".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff" };

    protected override async Task OnInitializedAsync() => await Data.InitializeAsync();

    private async Task Authenticate()
    {
        status = null;
        if (string.IsNullOrWhiteSpace(Email) || !Email.Contains('@'))
        {
            status = "Enter the email address for your AWYKEN account.";
            return;
        }
        if (string.IsNullOrWhiteSpace(Password))
        {
            status = "Enter your password to continue.";
            return;
        }
        if (CreateAccount && Password != ConfirmPassword)
        {
            status = "The passwords do not match.";
            return;
        }

        Working = true;
        try
        {
            status = CreateAccount
                ? await Data.SignUpAsync(string.IsNullOrWhiteSpace(DisplayName) ? Email.Trim() : DisplayName.Trim(), Email, Password)
                : await Data.SignInAsync(Email, Password);
            if (status is null && Data.IsAuthenticated)
                status = null;
            else if (status is null)
                status = "We couldn't sign you in. Please try again.";
        }
        catch (Exception)
        {
            status = "We couldn't access your account. Please try again.";
        }
        finally
        {
            Working = false;
        }
    }

    private async Task SelectFile(InputFileChangeEventArgs args)
    {
        if (!Data.IsAuthenticated)
        {
            status = "Log in before importing your COR.";
            return;
        }
        var file = args.File;
        if (file is null)
        {
            status = "Choose a COR PDF to continue.";
            return;
        }

        // Validate file extension
        var fileExtension = Path.GetExtension(file.Name).ToLower();
        if (!AllowedExtensions.Contains(fileExtension))
        {
            status = $"Invalid file type. Please upload PDF, JPG, PNG, BMP, or TIFF.";
            return;
        }

        // Validate file size (10 MB max)
        if (file.Size > 10 * 1024 * 1024)
        {
            status = "File is too large. Maximum size is 10 MB.";
            return;
        }

        status = "Scanning your COR...";
        CorImportResult result;
        try
        {
            result = await Importer.ImportAsync(file);
        }
        catch (Exception)
        {
            status = "The file could not be scanned. Try a clearer PDF or image.";
            return;
        }
        if (!result.IsSuccess)
        {
            status = result.Error;
            return;
        }

        // Keep the COR parsing and preview behavior intact, then attach the COR profile
        // to the account that signed in before upload.
        State.SetImportPreview(result.Classes, result.Profile);
        try
        {
            if (result.Profile is not null)
                await Data.SaveImportedProfileAsync(result.Profile, DateOnly.FromDateTime(DateTime.Today));
            Navigation.NavigateTo("/verify-schedule");
        }
        catch (Exception)
        {
            status = "We couldn't save your COR details. Please try again.";
        }
    }
    private void EnterManually() => Navigation.NavigateTo("/add-class");
}
