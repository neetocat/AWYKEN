@page "/profile"
@using AWYKEN.Shared.Components
@using AWYKEN.Shared.Services
@using AWYKEN.Shared.Data
@inject AWYKEN.Shared.Services.DashboardState State
@inject IAwykenDataService Data
@inject NavigationManager Navigation

<PageTitle>My profile - AWYKEN</PageTitle>

<div class="profile-page">
    <main class="profile-content">
        <header class="profile-topbar">
            <button class="topbar-button" aria-label="Back to settings" @onclick='() => Navigation.NavigateTo("/settings")'>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <h1>My profile</h1>
            <button class="topbar-button" aria-label="@(IsEditing ? "Cancel editing" : "Edit profile")" @onclick="ToggleEditing" disabled="@IsSaving">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    @if (IsEditing)
                    {
                        <path d="m6 6 12 12M18 6 6 18" />
                    }
                    else
                    {
                        <path d="m15 5 4 4M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z" />
                    }
                </svg>
            </button>
        </header>

        <section class="profile-hero">
            <div class="profile-hero-avatar">@ProfileInitials</div>
            <h2>@DisplayName</h2>
            <p>@Email</p>
            <div class="profile-stats">
                <div><strong>@State.Schedule.Count</strong><span>Classes saved</span></div>
                <div><strong>1.0.0</strong><span>App version</span></div>
            </div>
        </section>

        @if (!IsEditing && !string.IsNullOrWhiteSpace(EditMessage))
        {
            <p class="profile-edit-message" role="status">@EditMessage</p>
        }

        @if (IsEditing)
        {
            <form class="profile-edit-form" @onsubmit="SaveProfile" @onsubmit:preventDefault="true">
                <ProfileGroup Title="Personal information">
                    <label class="profile-edit-field">Full name<input @bind="FullNameInput" autocomplete="name" maxlength="150" required /></label>
                    <label class="profile-edit-field">School email<input type="email" @bind="EmailInput" autocomplete="email" maxlength="200" /></label>
                    <label class="profile-edit-field">Address<input @bind="AddressInput" autocomplete="street-address" maxlength="300" /></label>
                    <label class="profile-edit-field">Guardian<input @bind="GuardianInput" maxlength="150" /></label>
                    <label class="profile-edit-field">Gender<input @bind="GenderInput" maxlength="40" /></label>
                    <label class="profile-edit-field">Date of birth<input type="date" @bind="DateOfBirthInput" /></label>
                    <label class="profile-edit-field">Mobile number<input type="tel" @bind="PhoneInput" autocomplete="tel" maxlength="40" /></label>
                </ProfileGroup>

                <ProfileGroup Title="Academic information">
                    <label class="profile-edit-field">Student number<input @bind="StudentNumberInput" maxlength="30" /></label>
                    <label class="profile-edit-field">College<input @bind="CollegeInput" maxlength="200" /></label>
                    <label class="profile-edit-field">Program<input @bind="ProgramInput" maxlength="200" /></label>
                    <label class="profile-edit-field">Year level<input @bind="YearLevelInput" maxlength="40" /></label>
                    <label class="profile-edit-field">Academic year &amp; semester<input @bind="AcademicTermInput" maxlength="80" /></label>
                </ProfileGroup>

                <ProfileGroup Title="Locations">
                    <label class="profile-edit-field">Home location<input @bind="HomeAddressInput" autocomplete="street-address" maxlength="300" /></label>
                    <label class="profile-edit-field">Campus<input @bind="SchoolAddressInput" maxlength="300" /></label>
                    <p class="profile-edit-hint">If you change an address, update the route from the Commute page to refresh its map coordinates.</p>
                </ProfileGroup>

                @if (!string.IsNullOrWhiteSpace(EditError))
                {
                    <p class="profile-edit-message error" role="alert">@EditError</p>
                }
                @if (!string.IsNullOrWhiteSpace(EditMessage))
                {
                    <p class="profile-edit-message" role="status">@EditMessage</p>
                }

                <div class="profile-edit-actions">
                    <button type="button" class="profile-cancel-button" @onclick="CancelEditing" disabled="@IsSaving">Cancel</button>
                    <button type="submit" class="profile-save-button" disabled="@IsSaving">@(IsSaving ? "Saving…" : "Save profile")</button>
                </div>
            </form>
        }
        else
        {
            <ProfileGroup Title="Personal information">
                <ProfileRow Icon="person" Label="Full name" Value="@DisplayName" />
                <ProfileRow Icon="mail" Label="School email" Value="@Email" />
                <ProfileRow Icon="pin" Label="Address" Value="@Show(Student.Address, "[Add address]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Address)" />
                <ProfileRow Icon="person" Label="Guardian" Value="@Show(Student.Guardian, "[Add guardian]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Guardian)" />
                <ProfileRow Icon="person" Label="Gender" Value="@Show(Student.Gender, "[Add gender]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Gender)" />
                <ProfileRow Icon="year" Label="Date of birth" Value="@Show(Student.DateOfBirth, "[Add date of birth]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.DateOfBirth)" />
                <ProfileRow Icon="phone" Label="Mobile number" Value="@Show(Student.Phone, "[Add mobile number]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Phone)" />
            </ProfileGroup>

            <ProfileGroup Title="Academic information">
                <ProfileRow Icon="id" Label="Student number" Value="@Show(Student.StudentNumber, "[Add student number]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.StudentNumber)" />
                <ProfileRow Icon="school" Label="College" Value="@Show(Student.College, "[Add college]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.College)" />
                <ProfileRow Icon="school" Label="Program" Value="@Show(Student.Program, "[Add program]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Program)" />
                <ProfileRow Icon="year" Label="Year level" Value="@Show(Student.YearLevel, "[Add year level]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.YearLevel)" />
                <ProfileRow Icon="year" Label="Academic year &amp; semester" Value="@Show(Student.AcademicTerm, "[Add academic year and semester]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.AcademicTerm)" />
            </ProfileGroup>

            <ProfileGroup Title="Locations">
                <ProfileRow Icon="pin" Label="Home location" Value="@HomeLocation" IsPlaceholder="@string.IsNullOrWhiteSpace(State.CommuteLocations.HomeAddress)" />
                <ProfileRow Icon="school" Label="Campus" Value="@Campus" />
            </ProfileGroup>
        }

        <ProfileGroup Title="Account &amp; security">
            <button type="button" class="profile-security-action" @onclick="OpenPasswordDialog">
                <ProfileRow Icon="lock" Label="Change password" Value="Update your account password" IsAction="true" />
            </button>
        </ProfileGroup>

        @if (ShowPasswordDialog)
        {
            <div class="profile-password-overlay" @onclick="ClosePasswordDialog">
                <section class="profile-password-dialog" role="dialog" aria-modal="true" aria-labelledby="change-password-title" @onclick:stopPropagation="true">
                    <h2 id="change-password-title">Change password</h2>
                    <p>Enter your current password, then choose a new one.</p>
                    <form @onsubmit="ChangePassword" @onsubmit:preventDefault="true">
                        <label class="profile-edit-field">Current password
                            <span class="profile-password-input-wrap"><input type="@(ShowCurrentPassword ? "text" : "password")" @bind="CurrentPasswordInput" autocomplete="current-password" required />
                                <button type="button" class="profile-password-toggle" aria-label="@(ShowCurrentPassword ? "Hide current password" : "Show current password")" aria-pressed="@ShowCurrentPassword" @onclick="() => ShowCurrentPassword = !ShowCurrentPassword"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>@if (ShowCurrentPassword) { <path d="m4 4 16 16"/> }</svg></button>
                            </span>
                        </label>
                        <label class="profile-edit-field">New password
                            <span class="profile-password-input-wrap"><input type="@(ShowNewPassword ? "text" : "password")" @bind="NewPasswordInput" autocomplete="new-password" minlength="8" required />
                                <button type="button" class="profile-password-toggle" aria-label="@(ShowNewPassword ? "Hide new password" : "Show new password")" aria-pressed="@ShowNewPassword" @onclick="() => ShowNewPassword = !ShowNewPassword"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>@if (ShowNewPassword) { <path d="m4 4 16 16"/> }</svg></button>
                            </span>
                        </label>
                        <label class="profile-edit-field">Confirm new password
                            <span class="profile-password-input-wrap"><input type="@(ShowPasswordConfirmation ? "text" : "password")" @bind="PasswordConfirmationInput" autocomplete="new-password" minlength="8" required />
                                <button type="button" class="profile-password-toggle" aria-label="@(ShowPasswordConfirmation ? "Hide confirmed password" : "Show confirmed password")" aria-pressed="@ShowPasswordConfirmation" @onclick="() => ShowPasswordConfirmation = !ShowPasswordConfirmation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>@if (ShowPasswordConfirmation) { <path d="m4 4 16 16"/> }</svg></button>
                            </span>
                        </label>
                        @if (!string.IsNullOrWhiteSpace(PasswordError)) { <p class="profile-edit-message error" role="alert">@PasswordError</p> }
                        @if (!string.IsNullOrWhiteSpace(PasswordMessage)) { <p class="profile-edit-message" role="status">@PasswordMessage</p> }
                        <div class="profile-edit-actions">
                            <button type="button" class="profile-cancel-button" @onclick="ClosePasswordDialog" disabled="@IsChangingPassword">Cancel</button>
                            <button type="submit" class="profile-save-button" disabled="@IsChangingPassword">@(IsChangingPassword ? "Saving…" : "Change password")</button>
                        </div>
                    </form>
                </section>
            </div>
        }
    </main>

    <nav class="bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span class="nav-label">Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span><span class="nav-label">Schedule</span></button>
        <button class="add-nav" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'><span class="add-button">+</span><span class="nav-label">Add</span></button>
        <button @onclick='() => Navigation.NavigateTo("/notes")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg></span><span class="nav-label">Notes</span></button>
        <button class="active" aria-current="page"><span class="nav-icon" aria-hidden="true">♙</span><span class="nav-label">Profile</span></button>
    </nav>
</div>

@code {
    private StudentProfile Student => State.Student;
    private bool IsEditing;
    private bool IsSaving;
    private bool ShowPasswordDialog;
    private bool ShowCurrentPassword;
    private bool ShowNewPassword;
    private bool ShowPasswordConfirmation;
    private bool IsChangingPassword;
    private string CurrentPasswordInput = "";
    private string NewPasswordInput = "";
    private string PasswordConfirmationInput = "";
    private string? PasswordError;
    private string? PasswordMessage;
    private string? EditError;
    private string? EditMessage;
    private string FullNameInput = "";
    private string EmailInput = "";
    private string AddressInput = "";
    private string GuardianInput = "";
    private string GenderInput = "";
    private DateOnly? DateOfBirthInput;
    private string PhoneInput = "";
    private string StudentNumberInput = "";
    private string CollegeInput = "";
    private string ProgramInput = "";
    private string YearLevelInput = "";
    private string AcademicTermInput = "";
    private string HomeAddressInput = "";
    private string SchoolAddressInput = "";
    private string DisplayName => Student.FullName ?? State.User.DisplayName;
    private string Email => !string.IsNullOrWhiteSpace(Student.Email) ? Student.Email
        : string.IsNullOrWhiteSpace(State.User.Email) ? "No email saved" : State.User.Email;
    private string HomeLocation => string.IsNullOrWhiteSpace(State.CommuteLocations.HomeAddress)
        ? "Not set · tap Edit to add" : State.CommuteLocations.HomeAddress;
    private string Campus => string.IsNullOrWhiteSpace(State.CommuteLocations.SchoolAddress)
        ? "University of Makati" : State.CommuteLocations.SchoolAddress;

    private void OpenPasswordDialog()
    {
        ShowPasswordDialog = true;
        ShowCurrentPassword = ShowNewPassword = ShowPasswordConfirmation = false;
        PasswordError = PasswordMessage = null;
    }

    private void ClosePasswordDialog()
    {
        if (IsChangingPassword) return;
        ShowPasswordDialog = false;
        ShowCurrentPassword = ShowNewPassword = ShowPasswordConfirmation = false;
        CurrentPasswordInput = NewPasswordInput = PasswordConfirmationInput = "";
        PasswordError = PasswordMessage = null;
    }

    private async Task ChangePassword()
    {
        PasswordError = PasswordMessage = null;
        IsChangingPassword = true;
        try
        {
            PasswordError = await Data.ChangePasswordAsync(CurrentPasswordInput, NewPasswordInput, PasswordConfirmationInput);
            if (PasswordError is null)
            {
                PasswordMessage = "Your password has been changed.";
                CurrentPasswordInput = NewPasswordInput = PasswordConfirmationInput = "";
                ShowCurrentPassword = ShowNewPassword = ShowPasswordConfirmation = false;
            }
        }
        catch (Exception ex) { PasswordError = ex.GetBaseException().Message; }
        finally { IsChangingPassword = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));
        if (!Data.IsAuthenticated)
        {
            Navigation.NavigateTo("/settings");
            return;
        }
        PopulateEditFields();
    }

    private void ToggleEditing()
    {
        if (IsEditing)
        {
            CancelEditing();
            return;
        }
        PopulateEditFields();
        EditError = null;
        EditMessage = null;
        IsEditing = true;
    }

    private void PopulateEditFields()
    {
        FullNameInput = Student.FullName ?? State.User.DisplayName ?? "";
        EmailInput = Student.Email ?? "";
        AddressInput = Student.Address ?? "";
        GuardianInput = Student.Guardian ?? "";
        GenderInput = Student.Gender ?? "";
        DateOfBirthInput = ParseDateForInput(Student.DateOfBirth);
        PhoneInput = Student.Phone ?? "";
        StudentNumberInput = Student.StudentNumber ?? "";
        CollegeInput = Student.College ?? "";
        ProgramInput = Student.Program ?? "";
        YearLevelInput = Student.YearLevel ?? "";
        AcademicTermInput = Student.AcademicTerm ?? "";
        HomeAddressInput = State.CommuteLocations.HomeAddress ?? "";
        SchoolAddressInput = State.CommuteLocations.SchoolAddress ?? "";
    }

    private void CancelEditing()
    {
        PopulateEditFields();
        IsEditing = false;
        EditError = null;
    }

    private async Task SaveProfile()
    {
        EditError = null;
        EditMessage = null;
        if (string.IsNullOrWhiteSpace(FullNameInput))
        {
            EditError = "Enter your full name.";
            return;
        }
        if (!string.IsNullOrWhiteSpace(EmailInput) && !System.Net.Mail.MailAddress.TryCreate(EmailInput.Trim(), out _))
        {
            EditError = "Enter a valid school email address.";
            return;
        }

        IsSaving = true;
        try
        {
            var trimmedName = FullNameInput.Trim();
            var firstName = trimmedName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            var student = new StudentProfile(
                trimmedName, firstName, Optional(EmailInput), Optional(StudentNumberInput),
                Optional(CollegeInput), Optional(ProgramInput), Optional(YearLevelInput),
                Student.Section, Optional(AcademicTermInput), Optional(AddressInput),
                Optional(GuardianInput), Optional(GenderInput),
                DateOfBirthInput?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture), Optional(PhoneInput));
            var locations = new CommuteLocationSettings(
                Optional(HomeAddressInput), null, null, Optional(SchoolAddressInput), null, null);

            await Data.SaveProfileAsync(student, locations, DateOnly.FromDateTime(DateTime.Today));
            await Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));
            IsEditing = false;
            EditMessage = "Profile saved.";
        }
        catch (Exception)
        {
            EditError = "We couldn't save your profile. Please try again.";
        }
        finally
        {
            IsSaving = false;
        }
    }

    private static string? Optional(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static DateOnly? ParseDateForInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        return DateOnly.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date)
            ? date
            : null;
    }

    private string ProfileInitials
    {
        get
        {
            var name = string.IsNullOrWhiteSpace(Student.FullName) ? State.User.DisplayName : Student.FullName;
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length == 0 ? "G" : string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
        }
    }

    private static string Show(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;
}
