@page "/profile"
@using AWYKEN.Shared.Data
@using AWYKEN.Shared.Services
@inject AWYKEN.Shared.Services.DashboardState State
@inject IAwykenDataService Data
@inject NavigationManager Navigation

<PageTitle>AWYKEN</PageTitle>

<div class="flow-shell settings-screen profile-screen">
    <main class="flow-scroll">
        <div class="flow-content">
            <header class="settings-header app-page-header">
                <div class="brand-mark" role="img" aria-label="AWYKEN logo">
                    <img src="_content/AWYKEN.Shared/images/icon/awyken-logo-transparent-cut.png" alt="AWYKEN logo" />
                </div>
                <div class="settings-title">
                    <h1>Profile</h1>
                    <p>Your details from your COR</p>
                </div>
            </header>

            <section class="profile-card">
                <div class="avatar">@ProfileInitials</div>
                <div class="profile-copy">
                    <h2>@(Student.FullName ?? State.User.DisplayName)</h2>
                    <p>@(string.IsNullOrWhiteSpace(State.User.Email) ? "No email saved" : State.User.Email)</p>
                </div>
            </section>

            @if (!Student.HasDetails)
            {
                <section class="cor-empty">
                    <strong>No COR imported yet</strong>
                    <p>Import your COR and AWYKEN will fill in your student details for you.</p>
                    <button class="cor-empty__action" @onclick='() => Navigation.NavigateTo("/import-cor")'>Import COR</button>
                </section>
            }

            <section class="settings-section">
                <h2>STUDENT DETAILS</h2>
                <div class="settings-row"><span class="row-icon">#</span><span class="row-copy"><strong>Student number</strong><small>@Show(Student.StudentNumber)</small></span></div>
                <div class="settings-row"><span class="row-icon">▦</span><span class="row-copy"><strong>College</strong><small>@Show(Student.College)</small></span></div>
                <div class="settings-row"><span class="row-icon">▦</span><span class="row-copy"><strong>Program</strong><small>@Show(Student.Program)</small></span></div>
                <div class="settings-row"><span class="row-icon">↗</span><span class="row-copy"><strong>Year level</strong><small>@Show(Student.YearLevel)</small></span></div>
                <div class="settings-row"><span class="row-icon">⌗</span><span class="row-copy"><strong>Section</strong><small>@Show(Student.Section)</small></span></div>
                <div class="settings-row"><span class="row-icon">◷</span><span class="row-copy"><strong>School year and term</strong><small>@Show(Student.AcademicTerm)</small></span></div>
            </section>

            @if (Student.HasDetails)
            {
                <section class="settings-section">
                    <button class="settings-row" @onclick='() => Navigation.NavigateTo("/import-cor")'>
                        <span class="row-icon">⌗</span><span class="row-copy"><strong>Update from a new COR</strong><small>Scan or upload a document</small></span><span class="row-chevron">›</span>
                    </button>
                </section>
            }
        </div>
    </main>

    <nav class="bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span class="nav-label">Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span><span class="nav-label">Schedule</span></button>
        <button class="add-nav" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'><span class="add-button">+</span><span class="nav-label">Add</span></button>
        <button @onclick='() => Navigation.NavigateTo("/notes")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg></span><span class="nav-label">Notes</span></button>
        <button class="active"><span class="nav-icon">♙</span><span class="nav-label">Profile</span></button>
    </nav>
</div>

@code {
    private StudentProfile Student => State.Student;

    protected override Task OnInitializedAsync() =>
        Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));

    private static string Show(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "Not set" : value;

    private string ProfileInitials => string.IsNullOrWhiteSpace(State.User.FirstName)
        ? "G"
        : string.Concat(State.User.FirstName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
