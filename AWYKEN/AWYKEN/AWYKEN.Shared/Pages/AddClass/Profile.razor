@page "/profile"
@using AWYKEN.Shared.Components
@using AWYKEN.Shared.Services
@inject AWYKEN.Shared.Services.DashboardState State
@inject NavigationManager Navigation

<PageTitle>My profile - AWYKEN</PageTitle>

<div class="profile-page">
    <main class="profile-content">
        <header class="profile-topbar">
            <button class="topbar-button" aria-label="Back to settings" @onclick='() => Navigation.NavigateTo("/settings")'>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <h1>My profile</h1>
            <button class="topbar-button" aria-label="Edit profile" @onclick='() => Navigation.NavigateTo("/settings")'>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5 4 4M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2 4 20Z" /></svg>
            </button>
        </header>

        <section class="profile-hero">
            <div class="profile-hero-avatar">@ProfileInitials</div>
            <h2>@DisplayName</h2>
            <p>@Email</p>
            <div class="profile-stats">
                <div><strong>@State.Schedule.Count</strong><span>Classes saved</span></div>
                <div><strong>1.0.0</strong><span>App version</span></div>
            </div>
        </section>

        <ProfileGroup Title="Personal information">
            <ProfileRow Icon="person" Label="Full name" Value="@DisplayName" />
            <ProfileRow Icon="mail" Label="School email" Value="@Email" />
            <ProfileRow Icon="pin" Label="Address" Value="@Show(Student.Address, "[Add address]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Address)" />
            <ProfileRow Icon="person" Label="Guardian" Value="@Show(Student.Guardian, "[Add guardian]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Guardian)" />
            <ProfileRow Icon="person" Label="Gender" Value="@Show(Student.Gender, "[Add gender]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Gender)" />
            <ProfileRow Icon="year" Label="Date of birth" Value="@Show(Student.DateOfBirth, "[Add date of birth]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.DateOfBirth)" />
            <ProfileRow Icon="phone" Label="Mobile number" Value="[Add mobile number]" IsPlaceholder="true" />
        </ProfileGroup>

        <ProfileGroup Title="Academic information">
            <ProfileRow Icon="id" Label="Student number" Value="@Show(Student.StudentNumber, "[Add student number]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.StudentNumber)" />
            <ProfileRow Icon="school" Label="College" Value="@Show(Student.College, "[Add college]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.College)" />
            <ProfileRow Icon="school" Label="Program" Value="@Show(Student.Program, "[Add program]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.Program)" />
            <ProfileRow Icon="year" Label="Year level" Value="@Show(Student.YearLevel, "[Add year level]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.YearLevel)" />
            <ProfileRow Icon="year" Label="Academic year &amp; semester" Value="@Show(Student.AcademicTerm, "[Add academic year and semester]")" IsPlaceholder="@string.IsNullOrWhiteSpace(Student.AcademicTerm)" />
        </ProfileGroup>

        <ProfileGroup Title="Locations">
            <ProfileRow Icon="pin" Label="Home location" Value="@HomeLocation" IsPlaceholder="@string.IsNullOrWhiteSpace(State.CommuteLocations.HomeAddress)" />
            <ProfileRow Icon="school" Label="Campus" Value="@Campus" />
        </ProfileGroup>

        <ProfileGroup Title="Account &amp; security">
            <ProfileRow Icon="lock" Label="Change password" Value="Last updated: not available" IsAction="true" />
        </ProfileGroup>
    </main>

    <nav class="bottom-nav" aria-label="Main navigation">
        <button @onclick='() => Navigation.NavigateTo("/")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg></span><span class="nav-label">Home</span></button>
        <button @onclick='() => Navigation.NavigateTo("/schedule")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span><span class="nav-label">Schedule</span></button>
        <button class="add-nav" aria-label="Add class" @onclick='() => Navigation.NavigateTo("/add-class")'><span class="add-button">+</span><span class="nav-label">Add</span></button>
        <button @onclick='() => Navigation.NavigateTo("/notes")'><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 12h7M9 16h7" /></svg></span><span class="nav-label">Notes</span></button>
        <button class="active" aria-current="page"><span class="nav-icon" aria-hidden="true">♙</span><span class="nav-label">Profile</span></button>
    </nav>
</div>

@code {
    private StudentProfile Student => State.Student;
    private string DisplayName => Student.FullName ?? State.User.DisplayName;
    private string Email => !string.IsNullOrWhiteSpace(Student.Email) ? Student.Email
        : string.IsNullOrWhiteSpace(State.User.Email) ? "No email saved" : State.User.Email;
    private string HomeLocation => string.IsNullOrWhiteSpace(State.CommuteLocations.HomeAddress)
        ? "Not set · tap Edit to add" : State.CommuteLocations.HomeAddress;
    private string Campus => string.IsNullOrWhiteSpace(State.CommuteLocations.SchoolAddress)
        ? "University of Makati" : State.CommuteLocations.SchoolAddress;

    private string ProfileInitials
    {
        get
        {
            var name = string.IsNullOrWhiteSpace(Student.FullName) ? State.User.DisplayName : Student.FullName;
            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length == 0 ? "G" : string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
        }
    }

    private static string Show(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;
}
