@page "/verify-schedule"
@using AWYKEN.Shared.Data
@inject AWYKEN.Shared.Services.DashboardState State
@inject IAwykenDataService Data
@inject NavigationManager Navigation

<PageTitle>Verify your schedule • AWYKEN</PageTitle>

<div class="flow-shell verify-screen">
    <main class="flow-scroll">
        <div class="flow-content">
            <header class="flow-header">
                <button class="back-button" @onclick='() => Navigation.NavigateTo("/import-cor")' aria-label="Back">‹</button>
                <div><h1>Verify your schedule</h1><p>Step 2 of 2</p></div>
                <span class="found-badge">@State.Schedule.Count FOUND</span>
            </header>

            <section class="verify-callout"><strong>✦</strong><div><b>Import preview</b><p>Classes will appear here after document extraction is connected.</p></div></section>

            <div class="verify-summary">
                <div><strong>@State.Schedule.Count</strong><span>Classes saved for today</span></div><div><strong>0</strong><span>Waiting to review</span></div><div><strong>0</strong><span>Needs review</span></div>
            </div>

            <section class="review-list" aria-label="Imported classes">
                @if (State.Schedule.Count == 0)
                {
                    <p>No classes to review. The local schedule starts blank.</p>
                }
                else
                {
                    @foreach (var item in State.Schedule)
                    {
                        <article class="review-card accepted">
                            <span class="review-state">✓</span><div class="review-copy"><h2>@item.Title</h2><b>@item.CourseCode · @item.StartTime - @item.EndTime</b><p>@item.Location</p></div>
                        </article>
                    }
                }
            </section>
            <p class="review-note">Document extraction is not connected yet; no sample classes are inserted.</p>
        </div>
    </main>
    <div class="save-bar"><button class="primary-action" disabled>Save classes after review</button></div>
</div>

@code {
    // Keep the review screen consistent with the schedule currently stored locally.
    protected override Task OnInitializedAsync() =>
        Data.RefreshAsync(DateOnly.FromDateTime(DateTime.Today));
}
