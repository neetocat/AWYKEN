<div class="profile-row">
    <span class="profile-row-icon" aria-hidden="true">
        @switch (Icon)
        {
            case "person": <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg> break;
            case "mail": <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg> break;
            case "phone": <svg viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg> break;
            case "id": <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="8" cy="10" r="2"/><path d="M5.5 16a3 3 0 0 1 5 0M13 9h5M13 13h5"/></svg> break;
            case "school": <svg viewBox="0 0 24 24"><path d="m2 9 10-6 10 6-10 6L2 9Z"/><path d="M6 12v5c4 3 8 3 12 0v-5M22 9v7"/></svg> break;
            case "year": <svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M4 10h16"/></svg> break;
            case "pin": <svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg> break;
            case "lock": <svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 1 1 8 0v3"/></svg> break;
        }
    </span>
    <span class="profile-row-copy">
        <span class="profile-row-label">@Label</span>
        <strong class="@(IsPlaceholder ? "is-placeholder" : "")">@Value</strong>
    </span>
    @if (IsAction)
    {
        <svg class="profile-row-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public bool IsPlaceholder { get; set; }
    [Parameter] public bool IsAction { get; set; }
}
