# ---------------------------------------------------------------------------
# AWYKEN - Azure SQL Database keys
#
# Copy this file to ".env" in this repository root, then fill in the values:
#
#     Copy-Item .env.example .env        (PowerShell)
#     cp .env.example .env               (bash)
#
# ".env" is listed in .gitignore, so the real password never reaches Git.
# Both hosts read it: AWYKEN.Web (.NET web app) and AWYKEN (MAUI mobile app).
# ---------------------------------------------------------------------------

# --- Option A: one full ADO.NET connection string --------------------------
# When this key is present it wins over the discrete keys below.
#AZURE_SQL_CONNECTION_STRING=Server=tcp:awyken-sql.database.windows.net,1433;Initial Catalog=awyken;Persist Security Info=False;User ID=awykenadmin;Password=PASTE-PASSWORD-HERE;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# --- Option B: discrete keys (used when the connection string is empty) ----
# Server name only, without "tcp:" and without ",1433".
AZURE_SQL_SERVER=
# Database (catalog) name created in that server.
AZURE_SQL_DATABASE=awyken
# SQL login created on the server.
AZURE_SQL_USER=
# Password for that SQL login. Quote the value if it contains "#", spaces,
# a leading/trailing space, or any of: $ ` \
AZURE_SQL_PASSWORD=

# --- Optional --------------------------------------------------------------
# Sign in with Microsoft Entra ID instead of a SQL login. Supported values:
#   Active Directory Managed Identity  (App Service, Container Apps, VM, AKS)
#   Active Directory Service Principal (set AZURE_SQL_USER to the app/client id)
#   Active Directory Password
#   Active Directory Default           (needs the Azure.Identity package)
#AZURE_SQL_AUTHENTICATION=Active Directory Managed Identity

# Encrypt the connection. Azure SQL requires encryption, keep True.
#AZURE_SQL_ENCRYPT=True

# Only set True for a local SQL Server with a self-signed certificate.
#AZURE_SQL_TRUST_SERVER_CERTIFICATE=False

# Seconds to wait for a connection / for a command to finish.
#AZURE_SQL_CONNECT_TIMEOUT=30
#AZURE_SQL_COMMAND_TIMEOUT=60

# Apply pending EF Core migrations when the app starts. Keep True for development;
# a deployment pipeline can set False and run "dotnet ef database update" instead.
#AWYKEN_APPLY_MIGRATIONS_ON_START=True

# Comma-separated emails that are administrators. Matching accounts are flagged on
# sign-up / sign-in and are sent to /admin after logging in.
#AWYKEN_ADMIN_EMAILS=you@example.com

# --- Shared default admin ------------------------------------------------
# Optional. When both keys are set, the app creates this administrator the first
# time it connects, so every teammate can log in with the same credentials.
# The account is created only if it does not exist; an existing one keeps its
# password. Remove these keys after the demo, the account stays in the database.
#AWYKEN_DEFAULT_ADMIN_EMAIL=admin@awyken.local
#AWYKEN_DEFAULT_ADMIN_PASSWORD=Awyk3n-Shared-Admin-2026!
#AWYKEN_DEFAULT_ADMIN_NAME=Administrator
